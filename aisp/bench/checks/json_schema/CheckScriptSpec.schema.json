{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checks/json_schema/CheckScriptSpec.schema.json",
  "title": "CheckScriptSpec",
  "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckScriptSpec",
  "$defs": {
    "aisp.bench.checks.readme.checks.CheckScriptSpec": {
      "type": "object",
      "properties": {
        "script": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckScript"
        },
        "args": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckArgs"
        },
        "output": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckOutput"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckOutcome"
          }
        },
        "dependency": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckDependency"
        }
      },
      "required": [
        "script",
        "args",
        "output",
        "outcomes",
        "dependency"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckScript": {
      "oneOf": [
        {
          "const": "validate_repo"
        },
        {
          "const": "selftest"
        },
        {
          "const": "check_io_pattern"
        },
        {
          "const": "check_coverage"
        },
        {
          "const": "check_scaling_consistency"
        }
      ]
    },
    "aisp.bench.checks.readme.checks.CheckArgs": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "validate_repo": {
              "type": "null"
            }
          },
          "required": [
            "validate_repo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "selftest": {
              "type": "null"
            }
          },
          "required": [
            "selftest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "check_io_pattern": {
              "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckIoPatternArgs"
            }
          },
          "required": [
            "check_io_pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "check_coverage": {
              "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckCoverageArgs"
            }
          },
          "required": [
            "check_coverage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "check_scaling_consistency": {
              "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckScalingArgs"
            }
          },
          "required": [
            "check_scaling_consistency"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checks.readme.checks.CheckIoPatternArgs": {
      "type": "object",
      "properties": {
        "real": {
          "type": "string"
        },
        "bypassed": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        },
        "tolerance": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "real",
        "bypassed",
        "metrics",
        "tolerance"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckCoverageArgs": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        },
        "min_coverage": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "manifest",
        "metrics",
        "min_coverage"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckScalingArgs": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        }
      },
      "required": [
        "input",
        "metrics"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "json_line": {
              "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckJsonLine"
            }
          },
          "required": [
            "json_line"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "readable": {
              "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckReadableOutput"
            }
          },
          "required": [
            "readable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checks.readme.checks.CheckJsonLine": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckStatus"
        }
      },
      "required": [
        "check",
        "status"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckStatus": {
      "oneOf": [
        {
          "const": "pass"
        },
        {
          "const": "fail"
        },
        {
          "const": "skip"
        }
      ]
    },
    "aisp.bench.checks.readme.checks.CheckReadableOutput": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "items",
        "errors"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckOutcome": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckStatus"
        },
        "exit_code": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckExitCode"
        }
      },
      "required": [
        "status",
        "exit_code"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckExitCode": {
      "oneOf": [
        {
          "const": 0
        },
        {
          "const": 1
        },
        {
          "const": 2
        }
      ]
    },
    "aisp.bench.checks.readme.checks.CheckDependency": {
      "type": "object",
      "properties": {
        "install": {
          "type": "string"
        },
        "missing_status": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckStatus"
        },
        "missing_exit_code": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckExitCode"
        }
      },
      "required": [
        "install",
        "missing_status",
        "missing_exit_code"
      ],
      "additionalProperties": false
    }
  }
}
