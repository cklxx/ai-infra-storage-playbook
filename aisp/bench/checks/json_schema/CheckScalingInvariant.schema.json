{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checks/json_schema/CheckScalingInvariant.schema.json",
  "title": "CheckScalingInvariant",
  "$ref": "#/$defs/checks.CheckScalingInvariant",
  "$defs": {
    "checks.CheckScalingInvariant": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "tolerance": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "values",
        "tolerance"
      ],
      "additionalProperties": false
    }
  }
}
