{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checks/json_schema/CheckJsonLine.schema.json",
  "title": "CheckJsonLine",
  "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckJsonLine",
  "$defs": {
    "aisp.bench.checks.readme.checks.CheckJsonLine": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckStatus"
        }
      },
      "required": [
        "check",
        "status"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckStatus": {
      "oneOf": [
        {
          "const": "pass"
        },
        {
          "const": "fail"
        },
        {
          "const": "skip"
        }
      ]
    }
  }
}
