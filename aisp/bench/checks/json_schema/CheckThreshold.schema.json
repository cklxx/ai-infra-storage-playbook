{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checks/json_schema/CheckThreshold.schema.json",
  "title": "CheckThreshold",
  "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckThreshold",
  "$defs": {
    "aisp.bench.checks.readme.checks.CheckThreshold": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckThresholdSource"
        },
        "tolerance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/aisp.bench.checks.readme.checks.CheckToleranceValue"
          }
        },
        "items": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "tolerance",
        "items"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checks.readme.checks.CheckThresholdSource": {
      "oneOf": [
        {
          "const": "metrics_yaml"
        },
        {
          "const": "command_line"
        }
      ]
    },
    "aisp.bench.checks.readme.checks.CheckToleranceValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "number"
            }
          },
          "required": [
            "number"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "percent": {
              "type": "string"
            }
          },
          "required": [
            "percent"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
