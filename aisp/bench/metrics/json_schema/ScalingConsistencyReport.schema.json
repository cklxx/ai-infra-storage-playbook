{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/ScalingConsistencyReport.schema.json",
  "title": "ScalingConsistencyReport",
  "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyReport",
  "$defs": {
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyReport": {
      "type": "object",
      "properties": {
        "ladder": {
          "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyLadder"
        },
        "comparisons": {
          "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyComparisonSet"
        },
        "tolerance": {
          "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyTolerance"
        },
        "judgement": {
          "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyJudgement"
        }
      },
      "required": [
        "ladder",
        "comparisons",
        "tolerance",
        "judgement"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyLadder": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyLevelRecord"
          }
        }
      },
      "required": [
        "levels"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyLevelRecord": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.types.Level"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyMeasurement"
          }
        }
      },
      "required": [
        "level",
        "values"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.scaling.types.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyMeasurement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scalar": {
              "type": "number"
            }
          },
          "required": [
            "scalar"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "distribution": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "distribution"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyComparisonSet": {
      "type": "object",
      "properties": {
        "adjacent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyComparison"
          }
        },
        "first_last": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyComparison"
          }
        },
        "max_adjacent": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyComparison"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "comparable": {
          "type": "boolean"
        },
        "incomparable_reason": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "adjacent",
        "first_last",
        "max_adjacent",
        "comparable",
        "incomparable_reason"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyComparison": {
      "type": "object",
      "properties": {
        "invariant": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.types.Level"
        },
        "to": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.types.Level"
        },
        "deviation": {
          "type": "number"
        },
        "tolerance": {
          "type": "number"
        },
        "within": {
          "type": "boolean"
        }
      },
      "required": [
        "invariant",
        "from",
        "to",
        "deviation",
        "tolerance",
        "within"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyTolerance": {
      "type": "object",
      "properties": {
        "per_level": {
          "type": "number"
        },
        "first_last": {
          "type": "number"
        }
      },
      "required": [
        "per_level",
        "first_last"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyJudgement": {
      "type": "object",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyVerdict"
        },
        "drift": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyDrift"
          }
        },
        "failed_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "verdict",
        "drift",
        "failed_invariants"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyVerdict": {
      "oneOf": [
        {
          "const": "consistent"
        },
        {
          "const": "conditionally_consistent"
        },
        {
          "const": "inconsistent"
        },
        {
          "const": "wrong_invariant"
        },
        {
          "const": "incomparable"
        }
      ]
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyDrift": {
      "type": "object",
      "properties": {
        "invariant": {
          "type": "string"
        },
        "directions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyDirection"
          }
        },
        "monotonic": {
          "type": "boolean"
        }
      },
      "required": [
        "invariant",
        "directions",
        "monotonic"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.types.ScalingConsistencyDirection": {
      "oneOf": [
        {
          "const": "up"
        },
        {
          "const": "down"
        },
        {
          "const": "flat"
        }
      ]
    }
  }
}
