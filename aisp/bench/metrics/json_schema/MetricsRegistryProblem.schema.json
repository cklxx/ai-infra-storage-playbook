{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/MetricsRegistryProblem.schema.json",
  "title": "MetricsRegistryProblem",
  "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryProblem",
  "$defs": {
    "aisp.bench.metrics.readme.types.MetricsRegistryProblem": {
      "type": "object",
      "properties": {
