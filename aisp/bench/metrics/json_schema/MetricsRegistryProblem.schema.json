        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.readme.types.MetricsRegistryName": {
      "type": "string"
    },
    "aisp.bench.metrics.readme.types.MetricsRegistryProblemKind": {
      "oneOf": [
        {
          "const": "not_registered"
        },
        {
          "const": "version_not_supported"
        },
        {
          "const": "gate_not_declared"
        },
        {
          "const": "gate_not_in_acceptance"
        },
        {
          "const": "not_compatible"
        },
        {
          "const": "version_not_published"
        }
      ]
