{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/ScalingConsistencyComparison.schema.json",
  "title": "ScalingConsistencyComparison",
  "$ref": "#/$defs/scaling_consistency.ScalingConsistencyComparison",
  "$defs": {
    "scaling_consistency.ScalingConsistencyComparison": {
      "type": "object",
      "properties": {
        "invariant": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/levels.Level"
        },
        "to": {
          "$ref": "#/$defs/levels.Level"
        },
        "deviation": {
          "type": "number"
        },
        "tolerance": {
          "type": "number"
        },
        "within": {
          "type": "boolean"
        }
      },
      "required": [
        "invariant",
        "from",
        "to",
        "deviation",
        "tolerance",
        "within"
      ],
      "additionalProperties": false
    },
    "levels.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    }
  }
}
