{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/CoverageManifest.schema.json",
  "title": "CoverageManifest",
  "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageManifest",
  "$defs": {
    "aisp.bench.metrics.coverage.types.CoverageManifest": {
      "type": "object",
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageAxis"
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageCell"
          }
        }
      },
      "required": [
        "axes",
        "cells"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.coverage.types.CoverageAxis": {
      "oneOf": [
        {
          "const": "arch_family"
        },
        {
          "const": "model_scale"
        },
        {
          "const": "attention"
        },
        {
          "const": "framework"
        },
        {
          "const": "parallel"
        },
        {
          "const": "cluster"
        },
        {
          "const": "io_feature"
        },
        {
          "const": "storage_backend"
        },
        {
          "const": "storage_adapter"
        }
      ]
    },
    "aisp.bench.metrics.coverage.types.CoverageCell": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageCellKey"
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageCellState"
        },
        "exemption": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageExemption"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "state",
        "exemption"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.coverage.types.CoverageCellKey": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageAxisValue"
      }
    },
    "aisp.bench.metrics.coverage.types.CoverageAxisValue": {
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageAxis"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "axis",
        "value"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.coverage.types.CoverageCellState": {
      "oneOf": [
        {
          "const": "covered"
        },
        {
          "const": "failed"
        },
        {
          "const": "stale"
        },
        {
          "const": "gap"
        },
        {
          "const": "exempt"
        }
      ]
    },
    "aisp.bench.metrics.coverage.types.CoverageExemption": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "review_due": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "review_due"
      ],
      "additionalProperties": false
    }
  }
}
