{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/IoPatternTolerance.schema.json",
  "title": "IoPatternTolerance",
  "$ref": "#/$defs/io_pattern.IoPatternTolerance",
  "$defs": {
    "io_pattern.IoPatternTolerance": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/io_pattern.IoPatternMetricItem"
        },
        "reference": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/io_pattern.IoPatternToleranceSource"
        },
        "calibration": {
          "oneOf": [
            {
              "$ref": "#/$defs/io_pattern.IoPatternCalibration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item",
        "reference",
        "limit",
        "source",
        "calibration"
      ],
      "additionalProperties": false
    },
    "io_pattern.IoPatternMetricItem": {
      "oneOf": [
        {
          "const": "request_size_distribution"
        },
        {
          "const": "read_write_ratio_bytes"
        },
        {
          "const": "read_write_ratio_ops"
        },
        {
          "const": "concurrency_p50"
        },
        {
          "const": "concurrency_p95"
        },
        {
          "const": "concurrency_max"
        },
        {
          "const": "sequentiality"
        },
        {
          "const": "hotness"
        },
        {
          "const": "per_token_kv_bytes"
        },
        {
          "const": "timing_peak"
        }
      ]
    },
    "io_pattern.IoPatternToleranceSource": {
      "oneOf": [
        {
          "const": "reference"
        },
        {
          "const": "calibrated"
        }
      ]
    },
    "io_pattern.IoPatternCalibration": {
      "type": "object",
      "properties": {
        "repeats": {
          "type": "integer"
        },
        "max_pairwise_difference": {
          "type": "number"
        },
        "date": {
          "type": "string"
        },
        "baseline_ref": {
          "type": "string"
        }
      },
      "required": [
        "repeats",
        "max_pairwise_difference",
        "date",
        "baseline_ref"
      ],
      "additionalProperties": false
    }
  }
}
