{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/CoverageStats.schema.json",
  "title": "CoverageStats",
  "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageStats",
  "$defs": {
    "aisp.bench.metrics.coverage.types.CoverageStats": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer"
        },
        "covered": {
          "type": "integer"
        },
        "ratio": {
          "type": "number"
        },
        "gap_ratio": {
          "type": "number"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageGap"
          }
        }
      },
      "required": [
        "denominator",
        "covered",
        "ratio",
        "gap_ratio",
        "gaps"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.coverage.types.CoverageGap": {
      "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageCellKey"
    },
    "aisp.bench.metrics.coverage.types.CoverageCellKey": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageAxisValue"
      }
    },
    "aisp.bench.metrics.coverage.types.CoverageAxisValue": {
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/aisp.bench.metrics.coverage.types.CoverageAxis"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "axis",
        "value"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.coverage.types.CoverageAxis": {
      "oneOf": [
        {
          "const": "arch_family"
        },
        {
          "const": "model_scale"
        },
        {
          "const": "attention"
        },
        {
          "const": "framework"
        },
        {
          "const": "parallel"
        },
        {
          "const": "cluster"
        },
        {
          "const": "io_feature"
        },
        {
          "const": "storage_backend"
        },
        {
          "const": "storage_adapter"
        }
      ]
    }
  }
}
