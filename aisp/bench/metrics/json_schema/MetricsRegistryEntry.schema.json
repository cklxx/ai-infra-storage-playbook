{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/MetricsRegistryEntry.schema.json",
  "title": "MetricsRegistryEntry",
  "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryEntry",
  "$defs": {
    "aisp.bench.metrics.readme.types.MetricsRegistryEntry": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryName"
        },
        "doc": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryVersion"
        },
        "supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryVersion"
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.gates.types.Gate"
          }
        },
        "unit": {
          "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryUnit"
        },
        "direction": {
          "$ref": "#/$defs/aisp.bench.metrics.readme.types.MetricsRegistryDirection"
        }
      },
      "required": [
        "name",
        "doc",
        "version",
        "supported",
        "gates",
        "unit",
        "direction"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.readme.types.MetricsRegistryName": {
      "type": "string"
    },
    "aisp.bench.metrics.readme.types.MetricsRegistryVersion": {
      "type": "string"
    },
    "aisp.bench.checkpoint.gates.types.Gate": {
      "oneOf": [
        {
          "const": "G0"
        },
        {
          "const": "G1"
        },
        {
          "const": "G2"
        },
        {
          "const": "G3"
        },
        {
          "const": "G4"
        }
      ]
    },
    "aisp.bench.metrics.readme.types.MetricsRegistryUnit": {
      "type": "string"
    },
    "aisp.bench.metrics.readme.types.MetricsRegistryDirection": {
      "type": "string"
    }
  }
}
