{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/IoPatternHistogram.schema.json",
  "title": "IoPatternHistogram",
  "$ref": "#/$defs/io_pattern.IoPatternHistogram",
  "$defs": {
    "io_pattern.IoPatternHistogram": {
      "type": "object",
      "properties": {
        "bucket_edges": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "bucket_edges",
        "counts"
      ],
      "additionalProperties": false
    }
  }
}
