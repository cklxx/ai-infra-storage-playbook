{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/ScalingConsistencyDrift.schema.json",
  "title": "ScalingConsistencyDrift",
  "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.scaling_consistency.ScalingConsistencyDrift",
  "$defs": {
    "aisp.bench.metrics.scaling_consistency.scaling_consistency.ScalingConsistencyDrift": {
      "type": "object",
      "properties": {
        "invariant": {
          "type": "string"
        },
        "directions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.metrics.scaling_consistency.scaling_consistency.ScalingConsistencyDirection"
          }
        },
        "monotonic": {
          "type": "boolean"
        }
      },
      "required": [
        "invariant",
        "directions",
        "monotonic"
      ],
      "additionalProperties": false
    },
    "aisp.bench.metrics.scaling_consistency.scaling_consistency.ScalingConsistencyDirection": {
      "oneOf": [
        {
          "const": "up"
        },
        {
          "const": "down"
        },
        {
          "const": "flat"
        }
      ]
    }
  }
}
