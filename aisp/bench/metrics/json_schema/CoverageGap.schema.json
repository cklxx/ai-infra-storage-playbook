{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/metrics/json_schema/CoverageGap.schema.json",
  "title": "CoverageGap",
  "$ref": "#/$defs/coverage.CoverageGap",
  "$defs": {
    "coverage.CoverageGap": {
      "$ref": "#/$defs/coverage.CoverageCellKey"
    },
    "coverage.CoverageCellKey": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage.CoverageAxisValue"
      }
    },
    "coverage.CoverageAxisValue": {
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/coverage.CoverageAxis"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "axis",
        "value"
      ],
      "additionalProperties": false
    },
    "coverage.CoverageAxis": {
      "oneOf": [
        {
          "const": "arch_family"
        },
        {
          "const": "model_scale"
        },
        {
          "const": "attention"
        },
        {
          "const": "framework"
        },
        {
          "const": "parallel"
        },
        {
          "const": "cluster"
        },
        {
          "const": "io_feature"
        },
        {
          "const": "storage_backend"
        },
        {
          "const": "storage_adapter"
        }
      ]
    }
  }
}
