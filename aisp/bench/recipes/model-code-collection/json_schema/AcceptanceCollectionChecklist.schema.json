{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/model-code-collection/json_schema/AcceptanceCollectionChecklist.schema.json",
  "title": "AcceptanceCollectionChecklist",
  "$ref": "#/$defs/acceptance_collection.AcceptanceCollectionChecklist",
  "$defs": {
    "acceptance_collection.AcceptanceCollectionChecklist": {
      "type": "object",
      "properties": {
        "target_count": {
          "type": "integer"
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance_collection.AcceptanceCollectionGate"
          }
        }
      },
      "required": [
        "target_count",
        "gates"
      ],
      "additionalProperties": false
    },
    "acceptance_collection.AcceptanceCollectionGate": {
      "type": "object",
      "properties": {
        "gate": {
          "$ref": "#/$defs/gates.Gate"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance_collection.AcceptanceCollectionItem"
          }
        }
      },
      "required": [
        "gate",
        "items"
      ],
      "additionalProperties": false
    },
    "gates.Gate": {
      "oneOf": [
        {
          "const": "G0"
        },
        {
          "const": "G1"
        },
        {
          "const": "G2"
        },
        {
          "const": "G3"
        },
        {
          "const": "G4"
        }
      ]
    },
    "acceptance_collection.AcceptanceCollectionItem": {
      "oneOf": [
        {
          "const": "g0_candidate_manifest_at_three_times_target"
        },
        {
          "const": "g0_one_model_runnable_pipeline_completed"
        },
        {
          "const": "g0_workspace_images_grouped_by_transformers_major"
        },
        {
          "const": "g1_mock_process_group_verified"
        },
        {
          "const": "g1_fidelity_boundary_filled_with_comm_l1"
        },
        {
          "const": "g1_time_sharing_schedule_recorded"
        },
        {
          "const": "g2_downstream_metric_versions_match"
        },
        {
          "const": "g2_coverage_script_passed_on_50_models"
        },
        {
          "const": "g3_scaling_deferred_to_scaling_plan"
        },
        {
          "const": "g4_manifest_uploaded_with_sha256"
        },
        {
          "const": "g4_coverage_gaps_prioritized"
        },
        {
          "const": "g4_unknown_code_role_counted_as_gap"
        },
        {
          "const": "g4_unpaired_training_counted_as_gap"
        },
        {
          "const": "g4_acceptance_targets_met"
        },
        {
          "const": "g4_rerun_files_and_sha256_identical"
        }
      ]
    }
  }
}
