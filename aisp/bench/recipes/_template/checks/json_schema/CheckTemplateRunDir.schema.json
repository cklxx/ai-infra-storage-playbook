      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateCaseFile"
          }
        }
      },
      "required": [
        "path",
        "files"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateCaseFile": {
      "oneOf": [
        {
          "const": "metrics.json"
        },
