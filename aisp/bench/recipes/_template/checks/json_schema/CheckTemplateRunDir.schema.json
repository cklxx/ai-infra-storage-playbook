{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/_template/checks/json_schema/CheckTemplateRunDir.schema.json",
  "title": "CheckTemplateRunDir",
  "$ref": "#/$defs/aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateRunDir",
