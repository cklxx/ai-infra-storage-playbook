{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/_template/checks/json_schema/CheckTemplateReport.schema.json",
  "title": "CheckTemplateReport",
  "$ref": "#/$defs/aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateReport",
  "$defs": {
    "aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateReport": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateStatus"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "status",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes._template.checks.readme.check_template.CheckTemplateStatus": {
      "oneOf": [
        {
          "const": "pass"
        },
        {
          "const": "fail"
        },
        {
          "const": "skip"
        }
      ]
    }
  }
}
