{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/_template/json_schema/AcceptanceTemplateRecord.schema.json",
  "title": "AcceptanceTemplateRecord",
  "$ref": "#/$defs/aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateRecord",
  "$defs": {
    "aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateRecord": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateCheck"
          }
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateCheck": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateItem"
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateCheckState"
        }
      },
      "required": [
        "item",
        "state"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateItem": {
      "oneOf": [
        {
          "const": "g0_runs_without_bypass"
        },
        {
          "const": "g0_run_config_recorded"
        },
        {
          "const": "g0_minimal_config_repeatable"
        },
        {
          "const": "g1_bypass_runs_same_flow"
        },
        {
          "const": "g1_fidelity_boundary_filled"
        },
        {
          "const": "g1_storage_and_transfer_not_l0"
        },
        {
          "const": "g1_known_bias_direction"
        },
        {
          "const": "g2_real_and_bypass_runs"
        },
        {
          "const": "g2_byte_deviation_within_one_percent_or_explained"
        },
        {
          "const": "g2_observation_overhead_within_three_percent"
        },
        {
          "const": "g2_all_alignment_items_within_tolerance_or_attributed"
        },
        {
          "const": "g2_alignment_report_linked"
        },
        {
          "const": "g3_complete_metrics_each_level"
        },
        {
          "const": "g3_invariant_adjacent_deviation_within_tolerance"
        },
        {
          "const": "g3_no_monotonic_regression"
        },
        {
          "const": "g3_nonlinearity_investigated"
        },
        {
          "const": "g3_next_level_prediction_written"
        },
        {
          "const": "g4_latest_run_written"
        },
        {
          "const": "g4_coverage_matrix_updated"
        },
        {
          "const": "g4_remaining_biases_logged"
        },
        {
          "const": "g4_versions_consistent"
        }
      ]
    },
    "aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateCheckState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "unchecked": {
              "type": "null"
            }
          },
          "required": [
            "unchecked"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "checked": {
              "$ref": "#/$defs/aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateEvidence"
            }
          },
          "required": [
            "checked"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.recipes._template.acceptance_checklist.acceptance_template.AcceptanceTemplateEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "backlink": {
              "type": "string"
            }
          },
          "required": [
            "backlink"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence_location": {
              "type": "string"
            }
          },
          "required": [
            "evidence_location"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
