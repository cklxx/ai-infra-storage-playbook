{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/_template/json_schema/RecipeTemplateAcceptanceChecklist.schema.json",
  "title": "RecipeTemplateAcceptanceChecklist",
