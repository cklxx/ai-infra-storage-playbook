{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/model_code_collection/json_schema/RecipeCollectionCandidateSet.schema.json",
  "title": "RecipeCollectionCandidateSet",
  "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCandidateSet",
  "$defs": {
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCandidateSet": {
      "type": "object",
      "properties": {
        "target": {
          "type": "integer"
        },
        "stop_at": {
          "type": "integer"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCandidate"
          }
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionWorkspace"
          }
        }
      },
      "required": [
        "target",
        "stop_at",
        "candidates",
        "workspaces"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCandidate": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "org",
        "license",
        "tags",
        "created_at"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionWorkspace": {
      "type": "object",
      "properties": {
        "framework_major": {
          "type": "string"
        },
        "dependencies": {
          "type": "string"
        },
        "disk_quota": {
          "type": "string"
        },
        "cleanup": {
          "type": "string"
        },
        "downloader": {
          "type": "string"
        }
      },
      "required": [
        "framework_major",
        "dependencies",
        "disk_quota",
        "cleanup",
        "downloader"
      ],
      "additionalProperties": false
    }
  }
}
