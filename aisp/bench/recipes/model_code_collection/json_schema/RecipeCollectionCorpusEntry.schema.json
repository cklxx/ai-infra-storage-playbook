{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/model_code_collection/json_schema/RecipeCollectionCorpusEntry.schema.json",
  "title": "RecipeCollectionCorpusEntry",
  "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCorpusEntry",
  "$defs": {
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCorpusEntry": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCandidate"
        },
        "download": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDownload"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_role": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCodeRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_role_evidence": {
          "type": "string"
        },
        "fingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "dedup": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDedupRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "runnable": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "training": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionTrainingPairing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate",
        "download",
        "code_role",
        "code_role_evidence",
        "fingerprint",
        "dedup",
        "runnable",
        "training"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCandidate": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "org",
        "license",
        "tags",
        "created_at"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDownload": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCodeFile"
          }
        },
        "commit": {
          "type": "string"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailure"
          }
        }
      },
      "required": [
        "files",
        "commit",
        "failures"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCodeFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailure": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailureKind"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailureKind": {
      "oneOf": [
        {
          "const": "network"
        },
        {
          "const": "permission"
        },
        {
          "const": "not_found"
        },
        {
          "const": "license_not_accepted"
        }
      ]
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCodeRole": {
      "oneOf": [
        {
          "const": "inference"
        },
        {
          "const": "pretrain"
        },
        {
          "const": "both"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFingerprint": {
      "type": "object",
      "properties": {
        "config": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "config",
        "code"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDedupRecord": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDedupDecision"
        },
        "dropped_by": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "group",
        "decision",
        "dropped_by"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDedupDecision": {
      "oneOf": [
        {
          "const": "kept"
        },
        {
          "const": "dropped"
        }
      ]
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableRecord": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableState"
        },
        "ranks": {
          "type": "integer"
        },
        "timeout_min": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableFailure"
          }
        }
      },
      "required": [
        "state",
        "ranks",
        "timeout_min",
        "failures"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableState": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableFailure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step",
        "summary"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionTrainingPairing": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionTrainingStatus"
        },
        "ref": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "ref"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionTrainingStatus": {
      "oneOf": [
        {
          "const": "paired"
        },
        {
          "const": "external"
        },
        {
          "const": "unpaired"
        }
      ]
    }
  }
}
