{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/model_code_collection/json_schema/RecipeCollectionDownload.schema.json",
  "title": "RecipeCollectionDownload",
  "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDownload",
  "$defs": {
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionDownload": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCodeFile"
          }
        },
        "commit": {
          "type": "string"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailure"
          }
        }
      },
      "required": [
        "files",
        "commit",
        "failures"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionCodeFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailure": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailureKind"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionFetchFailureKind": {
      "oneOf": [
        {
          "const": "network"
        },
        {
          "const": "permission"
        },
        {
          "const": "not_found"
        },
        {
          "const": "license_not_accepted"
        }
      ]
    }
  }
}
