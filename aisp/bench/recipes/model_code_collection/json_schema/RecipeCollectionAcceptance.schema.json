{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/model_code_collection/json_schema/RecipeCollectionAcceptance.schema.json",
  "title": "RecipeCollectionAcceptance",
  "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionAcceptance",
  "$defs": {
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionAcceptance": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionAcceptanceMetric"
          }
        },
        "checker": {
          "type": "string"
        },
        "checklist": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "metrics",
        "checker",
        "checklist",
        "owner"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionAcceptanceMetric": {
      "oneOf": [
        {
          "const": "runnable_model_count"
        },
        {
          "const": "runnable_rate"
        },
        {
          "const": "architecture_family_coverage"
        },
        {
          "const": "scale_coverage"
        },
        {
          "const": "attention_variant_coverage"
        },
        {
          "const": "training_pairing_rate"
        },
        {
          "const": "reproducible_corpus"
        }
      ]
    }
  }
}
