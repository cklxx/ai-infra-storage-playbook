{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/model_code_collection/json_schema/RecipeCollectionRunnableRecord.schema.json",
  "title": "RecipeCollectionRunnableRecord",
  "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableRecord",
  "$defs": {
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableRecord": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableState"
        },
        "ranks": {
          "type": "integer"
        },
        "timeout_min": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableFailure"
          }
        }
      },
      "required": [
        "state",
        "ranks",
        "timeout_min",
        "failures"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableState": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "aisp.bench.recipes.model_code_collection.readme.types.RecipeCollectionRunnableFailure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
