{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/checkpoint/json_schema/RecipeCheckpointConfig.schema.json",
  "title": "RecipeCheckpointConfig",
  "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointConfig",
  "$defs": {
    "aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointConfig": {
      "type": "object",
      "properties": {
        "parallel_coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointParallelLead"
          }
        },
        "checkpoint_implementation": {
          "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointVersionedName"
        },
        "write_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointWriteMode"
          }
        },
        "data_layout": {
          "type": "string"
        },
        "warmup_rounds": {
          "type": "integer"
        }
      },
      "required": [
        "parallel_coverage",
        "checkpoint_implementation",
        "write_modes",
        "data_layout",
        "warmup_rounds"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointParallelLead": {
      "oneOf": [
        {
          "const": "dp_led"
        },
        {
          "const": "tp_led"
        },
        {
          "const": "pp_led"
        },
        {
          "const": "ep"
        }
      ]
    },
    "aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointVersionedName": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointWriteMode": {
      "oneOf": [
        {
          "const": "sync"
        },
        {
          "const": "async"
        }
      ]
    }
  }
}
