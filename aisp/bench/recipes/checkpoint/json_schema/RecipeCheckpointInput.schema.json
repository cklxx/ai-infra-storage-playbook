{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/checkpoint/json_schema/RecipeCheckpointInput.schema.json",
  "title": "RecipeCheckpointInput",
  "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointInput",
