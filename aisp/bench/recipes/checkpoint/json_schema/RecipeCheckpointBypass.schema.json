{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/checkpoint/json_schema/RecipeCheckpointBypass.schema.json",
  "title": "RecipeCheckpointBypass",
  "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.recipe_checkpoint.RecipeCheckpointBypass",
  "$defs": {
    "aisp.bench.recipes.checkpoint.readme.recipe_checkpoint.RecipeCheckpointBypass": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.recipe_checkpoint.RecipeCheckpointBypassStep"
          }
        },
        "fidelity_boundary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.methodology.fidelity.FidelityBoundary"
          }
        },
        "run": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.RunRecord"
        }
      },
      "required": [
        "steps",
        "fidelity_boundary",
        "run"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.checkpoint.readme.recipe_checkpoint.RecipeCheckpointBypassStep": {
      "oneOf": [
        {
          "const": "meta_model"
        },
        {
          "const": "meta_forward"
        },
        {
          "const": "placeholder_backward"
        },
        {
          "const": "placeholder_optimizer"
        },
        {
          "const": "unchanged_checkpoint_io"
        }
      ]
    },
    "aisp.bench.checkpoint.methodology.fidelity.FidelityBoundary": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "bypassed": {
          "$ref": "#/$defs/aisp.bench.checkpoint.methodology.fidelity.Bypassed"
        },
        "method": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.methodology.bypass.BypassMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "fidelity": {
          "$ref": "#/$defs/aisp.bench.checkpoint.methodology.bypass.FidelityLevel"
        },
        "kept": {
          "type": "string"
        },
        "known_bias": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bypassed",
        "method",
        "fidelity",
        "kept",
        "known_bias"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.methodology.fidelity.Bypassed": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "aisp.bench.checkpoint.methodology.bypass.BypassMethod": {
      "oneOf": [
        {
          "const": "meta_device"
        },
        {
          "const": "module_mock"
        },
        {
          "const": "cpu_offload"
        },
        {
          "const": "real_small_scale"
        }
      ]
    },
    "aisp.bench.checkpoint.methodology.bypass.FidelityLevel": {
      "oneOf": [
        {
          "const": "L0"
        },
        {
          "const": "L1"
        },
        {
          "const": "L2"
        },
        {
          "const": "L3"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.RunRecord": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.State"
        },
        "progress": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.WorkProgress"
        },
        "artifacts": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Artifacts"
        }
      },
      "required": [
        "run_id",
        "state",
        "progress",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.State": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "queued": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.QueueProgress"
            }
          },
          "required": [
            "queued"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "running": {
              "type": "null"
            }
          },
          "required": [
            "running"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "null"
            }
          },
          "required": [
            "completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failed": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Failure"
            }
          },
          "required": [
            "failed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rejected": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Failure"
            }
          },
          "required": [
            "rejected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cancelled": {
              "type": "null"
            }
          },
          "required": [
            "cancelled"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.QueueProgress": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "integer"
        },
        "len": {
          "type": "integer"
        }
      },
      "required": [
        "pos",
        "len"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Failure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.WorkProgress": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Artifacts": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.performance.sli.CkptSli"
          }
        },
        "slo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.CkptSlo"
          }
        },
        "report": {
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "metrics",
        "slo",
        "report"
      ],
      "additionalProperties": false
    },
