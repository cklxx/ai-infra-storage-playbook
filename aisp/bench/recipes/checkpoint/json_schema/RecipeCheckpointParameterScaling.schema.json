{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/recipes/checkpoint/json_schema/RecipeCheckpointParameterScaling.schema.json",
  "title": "RecipeCheckpointParameterScaling",
  "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointParameterScaling",
  "$defs": {
    "aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointParameterScaling": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointParameterScalingCheck"
          }
        },
        "gate": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointGate"
        }
      },
      "required": [
        "checks",
        "gate"
      ],
      "additionalProperties": false
    },
    "aisp.bench.recipes.checkpoint.readme.types.RecipeCheckpointParameterScalingCheck": {
      "oneOf": [
        {
          "const": "per_rank_request_size_distribution"
        },
        {
          "const": "per_parameter_bytes"
        },
        {
          "const": "shard_count_and_size"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointGate": {
      "oneOf": [
        {
          "const": "G0"
        },
        {
          "const": "G1"
        },
        {
          "const": "G2"
        },
        {
          "const": "G3-a"
        },
        {
          "const": "G3-b"
        },
        {
          "const": "G4"
        }
      ]
    }
  }
}
