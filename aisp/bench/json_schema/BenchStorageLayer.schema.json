{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/BenchStorageLayer.schema.json",
  "title": "BenchStorageLayer",
  "$ref": "#/$defs/aisp.bench.readme.bench.BenchStorageLayer",
  "$defs": {
    "aisp.bench.readme.bench.BenchStorageLayer": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.readme.bench.BenchStorageLayerKind"
        },
        "component": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Component"
        },
        "env": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "component",
        "env"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.bench.BenchStorageLayerKind": {
      "oneOf": [
        {
          "const": "backend"
        },
        {
          "const": "adapter"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
