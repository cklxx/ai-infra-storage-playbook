{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/ContributingMetricRegistration.schema.json",
  "title": "ContributingMetricRegistration",
  "$ref": "#/$defs/aisp.bench.contributing.types.ContributingMetricRegistration",
  "$defs": {
    "aisp.bench.contributing.types.ContributingMetricRegistration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/aisp.bench.contributing.types.ContributingMetricVersion"
        },
        "deprecation": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.contributing.types.ContributingMetricDeprecation"
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.contributing.types.ContributingTolerance"
          }
        },
        "compatible_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.contributing.types.ContributingMetricVersion"
          }
        }
      },
      "required": [
        "name",
        "doc",
        "version",
        "deprecation",
        "tolerance",
        "compatible_metrics"
      ],
      "additionalProperties": false
    },
    "aisp.bench.contributing.types.ContributingMetricVersion": {
      "type": "string"
    },
    "aisp.bench.contributing.types.ContributingMetricDeprecation": {
      "type": "object",
      "properties": {
        "deprecated_version": {
          "$ref": "#/$defs/aisp.bench.contributing.types.ContributingMetricVersion"
        },
        "reason": {
          "type": "string"
        },
        "replacement_version": {
          "$ref": "#/$defs/aisp.bench.contributing.types.ContributingMetricVersion"
        }
      },
      "required": [
        "deprecated_version",
        "reason",
        "replacement_version"
      ],
      "additionalProperties": false
    },
    "aisp.bench.contributing.types.ContributingTolerance": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "file": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "file"
      ],
      "additionalProperties": false
    }
  }
}
