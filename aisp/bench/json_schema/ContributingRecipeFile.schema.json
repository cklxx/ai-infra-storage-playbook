{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/ContributingRecipeFile.schema.json",
  "title": "ContributingRecipeFile",
  "$ref": "#/$defs/aisp.bench.contributing.contributing.ContributingRecipeFile",
  "$defs": {
    "aisp.bench.contributing.contributing.ContributingRecipeFile": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.contributing.contributing.ContributingRecipeFileKind"
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "aisp.bench.contributing.contributing.ContributingRecipeFileKind": {
      "oneOf": [
        {
          "const": "recipe_yaml"
        },
        {
          "const": "metrics_yaml"
        },
        {
          "const": "readme"
        },
        {
          "const": "checks"
        }
      ]
    }
  }
}
