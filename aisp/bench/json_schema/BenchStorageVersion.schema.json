{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/BenchStorageVersion.schema.json",
  "title": "BenchStorageVersion",
  "$ref": "#/$defs/bench.BenchStorageVersion",
  "$defs": {
    "bench.BenchStorageVersion": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bench.BenchStorageLayer"
          }
        },
        "manifest": {
          "type": "string"
        },
        "changed_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bench.BenchStorageLayerKind"
          }
        }
      },
      "required": [
        "layers",
        "manifest",
        "changed_layers"
      ],
      "additionalProperties": false
    },
    "bench.BenchStorageLayer": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/bench.BenchStorageLayerKind"
        },
        "component": {
          "$ref": "#/$defs/types.Component"
        },
        "env": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "component",
        "env"
      ],
      "additionalProperties": false
    },
    "bench.BenchStorageLayerKind": {
      "oneOf": [
        {
          "const": "backend"
        },
        {
          "const": "adapter"
        }
      ]
    },
    "types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
