{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/BenchEvalSet.schema.json",
  "title": "BenchEvalSet",
  "$ref": "#/$defs/aisp.bench.readme.types.BenchEvalSet",
  "$defs": {
    "aisp.bench.readme.types.BenchEvalSet": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchSubject"
        },
        "entry": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.readme.types.BenchEvalSetEntry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject",
        "entry"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchSubject": {
      "oneOf": [
        {
          "const": "model_code_collection"
        },
        {
          "const": "checkpoint"
        },
        {
          "const": "dataset"
        },
        {
          "const": "kvcache"
        }
      ]
    },
    "aisp.bench.readme.types.BenchEvalSetEntry": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "measures": {
          "type": "string"
        },
        "cases_from": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipe_dir": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "measures",
        "cases_from",
        "outputs",
        "recipe_dir"
      ],
      "additionalProperties": false
    }
  }
}
