{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/BenchSpec.schema.json",
  "title": "BenchSpec",
  "$ref": "#/$defs/aisp.bench.readme.types.BenchSpec",
  "$defs": {
    "aisp.bench.readme.types.BenchSpec": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.readme.types.BenchSubject"
          }
        },
        "storage": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchStorageVersion"
        },
        "eval_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.readme.types.BenchEvalSet"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.readme.types.BenchMetricSet"
          }
        },
        "layout": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchLayout"
        }
      },
      "required": [
        "subjects",
        "storage",
        "eval_sets",
        "metrics",
        "layout"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchSubject": {
      "oneOf": [
        {
          "const": "model_code_collection"
        },
        {
          "const": "checkpoint"
        },
        {
          "const": "dataset"
        },
        {
          "const": "kvcache"
        }
      ]
    },
    "aisp.bench.readme.types.BenchStorageVersion": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.readme.types.BenchStorageLayer"
          }
        },
        "manifest": {
          "type": "string"
        },
        "changed_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.readme.types.BenchStorageLayerKind"
          }
        }
      },
      "required": [
        "layers",
        "manifest",
        "changed_layers"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchStorageLayer": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchStorageLayerKind"
        },
        "component": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Component"
        },
        "env": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "component",
        "env"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchStorageLayerKind": {
      "oneOf": [
        {
          "const": "backend"
        },
        {
          "const": "adapter"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchEvalSet": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchSubject"
        },
        "entry": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.readme.types.BenchEvalSetEntry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject",
        "entry"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchEvalSetEntry": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "measures": {
          "type": "string"
        },
        "cases_from": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipe_dir": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "measures",
        "cases_from",
        "outputs",
        "recipe_dir"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchMetricSet": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchSubject"
        },
        "tier": {
          "$ref": "#/$defs/aisp.bench.readme.types.BenchMetricTier"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "subject",
        "tier",
        "metrics"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchMetricTier": {
      "oneOf": [
        {
          "const": "sli"
        },
        {
          "const": "slo"
        }
      ]
    },
    "aisp.bench.readme.types.BenchLayout": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.readme.types.BenchRepoArea"
          }
        },
        "method_docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipe_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "root",
        "areas",
        "method_docs",
        "recipe_dirs"
      ],
      "additionalProperties": false
    },
    "aisp.bench.readme.types.BenchRepoArea": {
      "oneOf": [
        {
          "const": "playbook"
        },
        {
          "const": "checkpoint/json_schema"
        },
        {
          "const": "recipes"
        },
        {
          "const": "metrics"
        },
        {
          "const": "checks"
        },
        {
          "const": "schemas"
        },
        {
          "const": "scripts"
        },
        {
          "const": "meta-evaluation"
        },
        {
          "const": "decisions"
        },
        {
          "const": "examples"
        },
        {
          "const": "requirements.txt"
        },
        {
          "const": "CONTRIBUTING.md"
        },
        {
          "const": "CHANGELOG.md"
        }
      ]
    }
  }
}
