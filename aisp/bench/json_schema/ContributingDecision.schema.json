{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/json_schema/ContributingDecision.schema.json",
  "title": "ContributingDecision",
  "$ref": "#/$defs/aisp.bench.contributing.types.ContributingDecision",
  "$defs": {
    "aisp.bench.contributing.types.ContributingDecision": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "slug": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/aisp.bench.contributing.types.ContributingDecisionKind"
        },
        "background": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string"
        },
        "consequences": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "slug",
        "kind",
        "background",
        "candidates",
        "decision",
        "consequences"
      ],
      "additionalProperties": false
    },
    "aisp.bench.contributing.types.ContributingDecisionKind": {
      "oneOf": [
        {
          "const": "bypass_choice"
        },
        {
          "const": "scaling_invariant"
        },
        {
          "const": "version_binding"
        },
        {
          "const": "incomparable_change"
        }
      ]
    }
  }
}
