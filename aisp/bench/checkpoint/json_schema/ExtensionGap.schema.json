{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ExtensionGap.schema.json",
  "title": "ExtensionGap",
  "$ref": "#/$defs/aisp.bench.checkpoint.extension.types.ExtensionGap",
  "$defs": {
    "aisp.bench.checkpoint.extension.types.ExtensionGap": {
      "type": "object",
      "properties": {
        "cell": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.types.ExtensionCell"
        },
        "priority": {
          "type": "number"
        }
      },
      "required": [
        "cell",
        "priority"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.types.ExtensionCell": {
      "type": "object",
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cases": {
          "type": "integer"
        },
        "last_passed_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_failed_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "empty": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.extension.types.ExtensionEmptyKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "axes",
        "cases",
        "last_passed_at",
        "last_failed_at",
        "empty"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.types.ExtensionEmptyKind": {
      "oneOf": [
        {
          "const": "should_exist"
        },
        {
          "type": "object",
          "properties": {
            "not_needed": {
              "$ref": "#/$defs/aisp.bench.checkpoint.extension.types.ExtensionExemption"
            }
          },
          "required": [
            "not_needed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.extension.types.ExtensionExemption": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "review_date": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "review_date"
      ],
      "additionalProperties": false
    }
  }
}
