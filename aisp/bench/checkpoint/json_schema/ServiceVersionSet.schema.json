{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ServiceVersionSet.schema.json",
  "title": "ServiceVersionSet",
  "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.service.ServiceVersionSet",
  "$defs": {
    "aisp.bench.checkpoint.evaluation_service.service.ServiceVersionSet": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "framework": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.service.Framework"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Model"
        },
        "storage": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.StorageLayer"
        },
        "compatible_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "recipe",
        "metrics",
        "service",
        "framework",
        "model",
        "storage",
        "compatible_metrics"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.evaluation_service.service.Framework": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.StorageLayer": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Component"
        },
        "adapter": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Component"
        }
      },
      "required": [
        "backend",
        "adapter"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
