{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/MethodologyObservation.schema.json",
  "title": "MethodologyObservation",
  "$ref": "#/$defs/aisp.bench.checkpoint.measures.types.MethodologyObservation",
  "$defs": {
    "aisp.bench.checkpoint.measures.types.MethodologyObservation": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.observation.types.ObservationLayer"
          }
        },
        "byte_skew": {
          "type": "number"
        },
        "explanation": {
          "type": "string"
        },
        "overhead": {
          "type": "number"
        }
      },
      "required": [
        "layers",
        "byte_skew",
        "explanation",
        "overhead"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.observation.types.ObservationLayer": {
      "oneOf": [
        {
          "const": "app"
        },
        {
          "const": "sys"
        },
        {
          "const": "storage"
        }
      ]
    }
  }
}
