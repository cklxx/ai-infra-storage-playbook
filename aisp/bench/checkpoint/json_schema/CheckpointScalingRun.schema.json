{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CheckpointScalingRun.schema.json",
  "title": "CheckpointScalingRun",
  "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingRun",
  "$defs": {
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingRun": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingDimension"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.scaling.levels.Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "invariants_kept": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "target",
        "invariants_kept",
        "attribution"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingDimension": {
      "oneOf": [
        {
          "const": "parameter_count"
        },
        {
          "const": "cluster_size"
        },
        {
          "const": "data_parallel"
        },
        {
          "const": "tensor_pipeline_parallel"
        },
        {
          "const": "expert_parallel"
        }
      ]
    },
    "aisp.bench.checkpoint.scaling.levels.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    }
  }
}
