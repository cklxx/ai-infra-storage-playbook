        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "collection.CollectionGapKind": {
      "oneOf": [
        {
          "const": "unknown_code_role"
        },
        {
          "const": "unpaired_training"
        },
        {
          "const": "empty_cell"
        }
      ]
    }
  }
}
