{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionGap.schema.json",
  "title": "CollectionGap",
  "$ref": "#/$defs/collection.CollectionGap",
  "$defs": {
    "collection.CollectionGap": {
      "type": "object",
      "properties": {
