{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PerformanceSloResult.schema.json",
  "title": "PerformanceSloResult",
  "$ref": "#/$defs/performance.PerformanceSloResult",
  "$defs": {
    "performance.PerformanceSloResult": {
      "type": "object",
      "properties": {
        "sample_key": {
          "$ref": "#/$defs/performance.PerformanceSampleKey"
        },
        "slo_ref": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "target": {
          "type": "number"
        },
        "observed": {
          "type": "number"
        },
        "verdict": {
          "$ref": "#/$defs/performance.PerformanceSloVerdict"
        },
        "sli_uri": {
          "$ref": "#/$defs/performance.PerformanceSliUri"
        }
      },
      "required": [
        "sample_key",
        "slo_ref",
        "metric",
        "target",
        "observed",
        "verdict",
        "sli_uri"
      ],
      "additionalProperties": false
    },
    "performance.PerformanceSampleKey": {
      "type": "string"
    },
    "performance.PerformanceSloVerdict": {
      "oneOf": [
        {
          "const": "pass"
        },
        {
          "const": "fail"
        },
        {
          "const": "inconclusive"
        }
      ]
    },
    "performance.PerformanceSliUri": {
      "type": "string"
    }
  }
}
