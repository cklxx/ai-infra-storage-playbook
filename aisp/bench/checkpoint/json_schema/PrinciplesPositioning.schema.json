{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesPositioning.schema.json",
  "title": "PrinciplesPositioning",
  "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesPositioning",
  "$defs": {
    "aisp.bench.checkpoint.principles.principles.PrinciplesPositioning": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesPart"
          }
        },
        "output": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesQuestion"
          }
        }
      },
      "required": [
        "parts",
        "output",
        "questions"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesPart": {
      "oneOf": [
        {
          "const": "recipes"
        },
        {
          "const": "metrics"
        },
        {
          "const": "process"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet": {
      "oneOf": [
        {
          "const": "checkpoint"
        },
        {
          "const": "dataset"
        },
        {
          "const": "kvcache"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesQuestion": {
      "oneOf": [
        {
          "const": "what"
        },
        {
          "const": "how"
        },
        {
          "const": "next"
        }
      ]
    }
  }
}
