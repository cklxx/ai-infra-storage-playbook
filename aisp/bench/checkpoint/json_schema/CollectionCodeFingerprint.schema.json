{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionCodeFingerprint.schema.json",
  "title": "CollectionCodeFingerprint",
  "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFingerprint",
  "$defs": {
    "aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFingerprint": {
      "type": "object",
      "properties": {
        "module_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionKeyCall"
          }
        },
        "special": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionSpecialOp"
          }
        }
      },
      "required": [
        "module_classes",
        "calls",
        "special"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionKeyCall": {
      "oneOf": [
        {
          "const": "attention"
        },
        {
          "const": "norm"
        },
        {
          "const": "mlp"
        },
        {
          "const": "residual"
        },
        {
          "const": "routing"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionSpecialOp": {
      "oneOf": [
        {
          "const": "custom_kernel"
        },
        {
          "const": "fused_op"
        },
        {
          "const": "quantization_branch"
        }
      ]
    }
  }
}
