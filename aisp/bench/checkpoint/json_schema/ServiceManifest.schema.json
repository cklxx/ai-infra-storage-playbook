{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ServiceManifest.schema.json",
  "title": "ServiceManifest",
  "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.ServiceManifest",
  "$defs": {
    "aisp.bench.checkpoint.evaluation_service.types.ServiceManifest": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.RunRequest"
        },
        "service_version": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.State"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.ServiceArtifactFile"
          }
        }
      },
      "required": [
        "request",
        "service_version",
        "started_at",
        "finished_at",
        "state",
        "files"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.evaluation_service.types.RunRequest": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string"
        },
        "recipe_version": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Model"
        },
        "framework": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.Framework"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.types.Level"
        },
        "topology": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Topology"
        },
        "storage": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.StorageLayer"
        },
        "load": {
          "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.Load"
        },
        "observe": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.ObservationConfig"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "recipe",
        "recipe_version",
        "model",
        "framework",
        "level",
        "topology",
        "storage",
        "load",
        "observe",
        "seed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.evaluation_service.types.Framework": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.scaling.types.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Topology": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "gpus_per_node": {
          "type": "integer"
        },
        "network": {
          "type": "string"
        },
        "mount": {
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "gpus_per_node",
        "network",
        "mount"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.StorageLayer": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Component"
        },
        "adapter": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Component"
        }
      },
      "required": [
        "backend",
        "adapter"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.evaluation_service.types.Load": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "duration_s": {
          "type": "integer"
        },
        "input_len": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_len": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrival_interval_ms": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_size": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concurrency",
        "duration_s",
        "input_len",
        "output_len",
        "arrival_interval_ms",
        "batch_size"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.ObservationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "number"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.observation.types.ObservationLayer"
          }
        }
      },
      "required": [
        "enabled",
        "sample_rate",
        "layers"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.observation.types.ObservationLayer": {
      "oneOf": [
        {
          "const": "app"
        },
        {
          "const": "sys"
        },
        {
          "const": "storage"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample.types.State": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "queued": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.QueueProgress"
            }
          },
          "required": [
            "queued"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "running": {
              "type": "null"
            }
          },
          "required": [
            "running"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "null"
            }
          },
          "required": [
            "completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failed": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Failure"
            }
          },
          "required": [
            "failed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rejected": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Failure"
            }
          },
          "required": [
            "rejected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cancelled": {
              "type": "null"
            }
          },
          "required": [
            "cancelled"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample.types.QueueProgress": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "integer"
        },
        "len": {
          "type": "integer"
        }
      },
      "required": [
        "pos",
        "len"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Failure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.evaluation_service.types.ServiceArtifactFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
