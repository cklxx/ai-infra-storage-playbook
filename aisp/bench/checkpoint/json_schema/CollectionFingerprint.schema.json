{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionFingerprint.schema.json",
  "title": "CollectionFingerprint",
  "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionFingerprint",
  "$defs": {
    "aisp.bench.checkpoint.model_code_collection.types.CollectionFingerprint": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionConfigFingerprint"
        },
        "code": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFingerprint"
        }
      },
      "required": [
        "config",
        "code"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionConfigFingerprint": {
      "type": "object",
      "properties": {
        "architectures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "num_hidden_layers": {
          "type": "integer"
        },
        "hidden_size": {
          "type": "integer"
        },
        "num_attention_heads": {
          "type": "integer"
        },
        "num_key_value_heads": {
          "type": "integer"
        },
        "intermediate_size": {
          "type": "integer"
        },
        "vocab_size": {
          "type": "integer"
        },
        "max_position_embeddings": {
          "type": "integer"
        },
        "torch_dtype": {
          "type": "string"
        },
        "tie_word_embeddings": {
          "type": "boolean"
        },
        "moe": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionMoeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "positional_encoding": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionPositionalEncoding"
        },
        "attention": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionAttentionVariant"
        }
      },
      "required": [
        "architectures",
        "num_hidden_layers",
        "hidden_size",
        "num_attention_heads",
        "num_key_value_heads",
        "intermediate_size",
        "vocab_size",
        "max_position_embeddings",
        "torch_dtype",
        "tie_word_embeddings",
        "moe",
        "positional_encoding",
        "attention"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionMoeSpec": {
      "type": "object",
      "properties": {
        "num_experts": {
          "type": "integer"
        },
        "num_active_experts": {
          "type": "integer"
        },
        "num_shared_experts": {
          "type": "integer"
        }
      },
      "required": [
        "num_experts",
        "num_active_experts",
        "num_shared_experts"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionPositionalEncoding": {
      "oneOf": [
        {
          "const": "rope"
        },
        {
          "const": "alibi"
        },
        {
          "const": "absolute"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionAttentionVariant": {
      "oneOf": [
        {
          "const": "mha"
        },
        {
          "const": "gqa"
        },
        {
          "const": "mqa"
        },
        {
          "const": "mla"
        },
        {
          "const": "linear"
        },
        {
          "const": "sliding_window"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFingerprint": {
      "type": "object",
      "properties": {
        "module_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionKeyCall"
          }
        },
        "special": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionSpecialOp"
          }
        }
      },
      "required": [
        "module_classes",
        "calls",
        "special"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionKeyCall": {
      "oneOf": [
        {
          "const": "attention"
        },
        {
          "const": "norm"
        },
        {
          "const": "mlp"
        },
        {
          "const": "residual"
        },
        {
          "const": "routing"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionSpecialOp": {
      "oneOf": [
        {
          "const": "custom_kernel"
        },
        {
          "const": "fused_op"
        },
        {
          "const": "quantization_branch"
        }
      ]
    }
  }
}
