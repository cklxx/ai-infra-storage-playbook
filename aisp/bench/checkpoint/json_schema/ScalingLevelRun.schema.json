{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ScalingLevelRun.schema.json",
  "title": "ScalingLevelRun",
  "$ref": "#/$defs/aisp.bench.checkpoint.scaling.scale_types.ScalingLevelRun",
  "$defs": {
    "aisp.bench.checkpoint.scaling.scale_types.ScalingLevelRun": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.types.Level"
        },
        "dimension": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.scale_types.ScalingDimension"
        },
        "samples": {
          "type": "integer"
        },
        "complete_measurement": {
          "type": "boolean"
        },
        "invariants_kept": {
          "type": "boolean"
        },
        "focus": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "dimension",
        "samples",
        "complete_measurement",
        "invariants_kept",
        "focus",
        "attribution"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.scaling.types.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    },
    "aisp.bench.checkpoint.scaling.scale_types.ScalingDimension": {
      "oneOf": [
        {
          "const": "model_scale"
        },
        {
          "const": "cluster_size"
        },
        {
          "const": "parallel_strategy"
        },
        {
          "const": "load"
        },
        {
          "const": "storage_backend"
        }
      ]
    }
  }
}
