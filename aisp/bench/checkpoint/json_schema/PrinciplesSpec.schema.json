{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesSpec.schema.json",
  "title": "PrinciplesSpec",
  "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesSpec",
  "$defs": {
    "aisp.bench.checkpoint.principles.principles.PrinciplesSpec": {
      "type": "object",
      "properties": {
        "positioning": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesPositioning"
        },
        "benchmark": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesContinuousBenchmark"
        },
        "eval_sets": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesEvalSetRelation"
        },
        "scope": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesScope"
        },
        "hard_principles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesHardPrinciple"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesSuccessCriterion"
          }
        },
        "roles": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesRoles"
        }
      },
      "required": [
        "positioning",
        "benchmark",
        "eval_sets",
        "scope",
        "hard_principles",
        "success_criteria",
        "roles"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesPositioning": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesPart"
          }
        },
        "output": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesQuestion"
          }
        }
      },
      "required": [
        "parts",
        "output",
        "questions"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesPart": {
      "oneOf": [
        {
          "const": "recipes"
        },
        {
          "const": "metrics"
        },
        {
          "const": "process"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet": {
      "oneOf": [
        {
          "const": "checkpoint"
        },
        {
          "const": "dataset"
        },
        {
          "const": "kvcache"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesQuestion": {
      "oneOf": [
        {
          "const": "what"
        },
        {
          "const": "how"
        },
        {
          "const": "next"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesContinuousBenchmark": {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesBenchmarkReason"
          }
        },
        "loop": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesClosedLoop"
        }
      },
      "required": [
        "reasons",
        "loop"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesBenchmarkReason": {
      "oneOf": [
        {
          "const": "coverage"
        },
        {
          "const": "extrapolation"
        },
        {
          "const": "decay"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesClosedLoop": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesLoopPart"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesLoopStage"
          }
        },
        "human": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesHumanInLoop"
        }
      },
      "required": [
        "parts",
        "stages",
        "human"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesLoopPart": {
      "oneOf": [
        {
          "const": "eval_set"
        },
        {
          "const": "eval_service"
        },
        {
          "const": "extension"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesLoopStage": {
      "oneOf": [
        {
          "const": "current_set"
        },
        {
          "const": "service_run"
        },
        {
          "const": "gap_analysis"
        },
        {
          "const": "new_version"
        },
        {
          "const": "regression"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesHumanInLoop": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesAutomatedStep"
          }
        },
        "reviewed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesReviewSubject"
          }
        }
      },
      "required": [
        "automatic",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesAutomatedStep": {
      "oneOf": [
        {
          "const": "find_gaps"
        },
        {
          "const": "generate_candidates"
        },
        {
          "const": "regress"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesReviewSubject": {
      "oneOf": [
        {
          "const": "metric_change"
        },
        {
          "const": "threshold_change"
        },
        {
          "const": "incomparable_change"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesEvalSetRelation": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesModelCodeLibrary"
        },
        "derived": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet"
        },
        "recipe": {
          "type": "string"
        },
        "dependency": {
          "type": "string"
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet"
          }
        }
      },
      "required": [
        "source",
        "derived",
        "recipe",
        "dependency",
        "pending"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesModelCodeLibrary": {
      "type": "object",
      "properties": {
        "inference_models": {
          "type": "string"
        },
        "diversity": {
          "type": "string"
        },
        "mock_group": {
          "type": "string"
        }
      },
      "required": [
        "inference_models",
        "diversity",
        "mock_group"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesScope": {
      "type": "object",
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesIncludedWork"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesExcludedWork"
          }
        }
      },
      "required": [
        "included",
        "excluded"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesIncludedWork": {
      "oneOf": [
        {
          "const": "model_code"
        },
        {
          "const": "checkpoint"
        },
        {
          "const": "bypass"
        },
        {
          "const": "scaling"
        },
        {
          "const": "service"
        },
        {
          "const": "extension"
        },
        {
          "const": "metrics"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesExcludedWork": {
      "oneOf": [
        {
          "const": "performance_tuning"
        },
        {
          "const": "kernel_optimization"
        },
        {
          "const": "hardware_selection"
        },
        {
          "const": "production_ops"
        },
        {
          "const": "report_archival"
        },
        {
          "const": "raw_assets"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesHardPrinciple": {
      "oneOf": [
        {
          "const": "fake_compute_real_io"
        },
        {
          "const": "align_then_extrapolate"
        },
        {
          "const": "link_only"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesSuccessCriterion": {
      "oneOf": [
        {
          "const": "reproducible"
        },
        {
          "const": "aligned"
        },
        {
          "const": "scaling_validated"
        },
        {
          "const": "gaps_registered"
        },
        {
          "const": "loop_proven"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesRoles": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesRole"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesRoleRule"
          }
        }
      },
      "required": [
        "roles",
        "rules"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesRole": {
      "oneOf": [
        {
          "const": "recipe_maintainer"
        },
        {
          "const": "metric_maintainer"
        },
        {
          "const": "service_maintainer"
        },
        {
          "const": "reviewer"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesRoleRule": {
      "oneOf": [
        {
          "const": "allow_concurrent"
        },
        {
          "const": "no_self_review"
        }
      ]
    }
  }
}
