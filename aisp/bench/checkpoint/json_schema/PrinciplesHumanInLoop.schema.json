{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesHumanInLoop.schema.json",
  "title": "PrinciplesHumanInLoop",
  "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesHumanInLoop",
  "$defs": {
    "aisp.bench.checkpoint.principles.types.PrinciplesHumanInLoop": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesAutomatedStep"
          }
        },
        "reviewed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesReviewSubject"
          }
        }
      },
      "required": [
        "automatic",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesAutomatedStep": {
      "oneOf": [
        {
          "const": "find_gaps"
        },
        {
          "const": "generate_candidates"
        },
        {
          "const": "regress"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesReviewSubject": {
      "oneOf": [
        {
          "const": "metric_change"
        },
        {
          "const": "threshold_change"
        },
        {
          "const": "incomparable_change"
        }
      ]
    }
  }
}
