{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CheckpointAlignment.schema.json",
  "title": "CheckpointAlignment",
  "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointAlignment",
  "$defs": {
    "aisp.bench.checkpoint.checkpoint.types.CheckpointAlignment": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointAlignmentStep"
          }
        },
        "within_tolerance": {
          "type": "boolean"
        }
      },
      "required": [
        "steps",
        "within_tolerance"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointAlignmentStep": {
      "oneOf": [
        {
          "const": "minimal_config"
        },
        {
          "const": "real_and_bypass_runs"
        },
        {
          "const": "compare_metrics"
        },
        {
          "const": "attribute_deviations"
        }
      ]
    }
  }
}
