{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ServiceScheduling.schema.json",
  "title": "ServiceScheduling",
  "$ref": "#/$defs/service.ServiceScheduling",
  "$defs": {
    "service.ServiceScheduling": {
      "type": "object",
      "properties": {
        "priority_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service.ServicePriority"
          }
        },
        "time_slice_single_rank": {
          "type": "boolean"
        },
        "isolation": {
          "type": "string"
        },
        "quota": {
          "type": "string"
        },
        "preemptible": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service.ServicePriority"
          }
        },
        "high_bandwidth_parallel": {
          "type": "integer"
        }
      },
      "required": [
        "priority_order",
        "time_slice_single_rank",
        "isolation",
        "quota",
        "preemptible",
        "high_bandwidth_parallel"
      ],
      "additionalProperties": false
    },
    "service.ServicePriority": {
      "oneOf": [
        {
          "const": "regression"
        },
        {
          "const": "new_case"
        },
        {
          "const": "exploration"
        }
      ]
    }
  }
}
