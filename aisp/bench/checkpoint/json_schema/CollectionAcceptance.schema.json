{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionAcceptance.schema.json",
  "title": "CollectionAcceptance",
  "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.collection.CollectionAcceptance",
  "$defs": {
    "aisp.bench.checkpoint.model_code_collection.collection.CollectionAcceptance": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.collection.CollectionAcceptanceMetric"
          }
        },
        "checker": {
          "type": "string"
        }
      },
      "required": [
        "metrics",
        "checker"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.collection.CollectionAcceptanceMetric": {
      "oneOf": [
        {
          "const": "inference_code_count"
        },
        {
          "const": "runnable_rate"
        },
        {
          "const": "architecture_family_coverage"
        },
        {
          "const": "scale_coverage"
        },
        {
          "const": "attention_variant_coverage"
        },
        {
          "const": "training_pairing_rate"
        },
        {
          "const": "dedup_ratio"
        }
      ]
    }
  }
}
