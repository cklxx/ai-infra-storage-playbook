{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ExtensionLoop.schema.json",
  "title": "ExtensionLoop",
  "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension_flow.ExtensionLoop",
  "$defs": {
    "aisp.bench.checkpoint.extension.extension_flow.ExtensionLoop": {
      "type": "object",
      "properties": {
        "trigger": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionTrigger"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension_flow.ExtensionStep"
          }
        }
      },
      "required": [
        "trigger",
        "steps"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionTrigger": {
      "oneOf": [
        {
          "const": "new_model_release"
        },
        {
          "const": "framework_release"
        },
        {
          "const": "coverage_decline"
        },
        {
          "const": "failure_mode_change"
        },
        {
          "const": "new_parallel_strategy"
        },
        {
          "const": "storage_backend_change"
        },
        {
          "const": "overturned_conclusion"
        }
      ]
    },
    "aisp.bench.checkpoint.extension.extension_flow.ExtensionStep": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "find_gap": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionGap"
              }
            }
          },
          "required": [
            "find_gap"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "propose_candidate": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionCandidate"
              }
            }
          },
          "required": [
            "propose_candidate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "regress": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionRegression"
              }
            }
          },
          "required": [
            "regress"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "converge": {
              "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionVersion"
            }
          },
          "required": [
            "converge"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionGap": {
      "type": "object",
      "properties": {
        "cell": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionCell"
        },
        "priority": {
          "type": "number"
        }
      },
      "required": [
        "cell",
        "priority"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionCell": {
      "type": "object",
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cases": {
          "type": "integer"
        },
        "last_passed_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_failed_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "empty": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionEmptyKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "axes",
        "cases",
        "last_passed_at",
        "last_failed_at",
        "empty"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionEmptyKind": {
      "oneOf": [
        {
          "const": "should_exist"
        },
        {
          "type": "object",
          "properties": {
            "not_needed": {
              "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionExemption"
            }
          },
          "required": [
            "not_needed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionExemption": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "review_date": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "review_date"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionCandidate": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionCandidateSource"
        },
        "model": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Model"
        },
        "config": {
          "type": "string"
        },
        "load": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "model",
        "config",
        "load"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionCandidateSource": {
      "oneOf": [
        {
          "const": "model_list_new_item"
        },
        {
          "const": "architecture_family_gap"
        },
        {
          "const": "framework_capability_gap"
        },
        {
          "const": "failure_reproduction"
        },
        {
          "const": "load_gap"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.ckpt_sample.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionRegression": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionCandidate"
        },
        "scope": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionRegressionScope"
        },
        "baseline": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/aisp.bench.checkpoint.extension.extension.ExtensionRegressionVerdict"
        }
      },
      "required": [
        "candidate",
        "scope",
        "baseline",
        "verdict"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionRegressionScope": {
      "oneOf": [
        {
          "const": "smoke"
        },
        {
          "const": "regular"
        },
        {
          "const": "full"
        }
      ]
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionRegressionVerdict": {
      "oneOf": [
        {
          "const": "passed"
        },
        {
          "const": "not_comparable"
        },
        {
          "const": "failed"
        },
        {
          "const": "no_conclusion"
        }
      ]
    },
    "aisp.bench.checkpoint.extension.extension.ExtensionVersion": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string"
        },
        "cases": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        }
      },
      "required": [
        "recipe",
        "cases",
        "metrics"
      ],
      "additionalProperties": false
    }
  }
}
