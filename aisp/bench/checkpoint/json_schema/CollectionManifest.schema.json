{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionManifest.schema.json",
  "title": "CollectionManifest",
  "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionManifest",
  "$defs": {
    "aisp.bench.checkpoint.model_code_collection.types.CollectionManifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionManifestEntry"
          }
        }
      },
      "required": [
        "version",
        "sha256",
        "entries"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionManifestEntry": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Model"
        },
        "source": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionSource"
        },
        "license": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionLicense"
        },
        "params_b": {
          "type": "number"
        },
        "code_role": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionCodeRole"
        },
        "code_role_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionCodeRoleEvidence"
          }
        },
        "download": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionDownload"
        },
        "fingerprint": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionFingerprint"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionWorkspace"
          }
        },
        "dedup": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionDedupRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "runnable": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "training": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionTrainingPairing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "source",
        "license",
        "params_b",
        "code_role",
        "code_role_evidence",
        "download",
        "fingerprint",
        "workspaces",
        "dedup",
        "runnable",
        "training"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionSource": {
      "oneOf": [
        {
          "const": "hub_api"
        },
        {
          "const": "org_page"
        },
        {
          "const": "paper"
        },
        {
          "const": "own_registry"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionLicense": {
      "type": "object",
      "properties": {
        "id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionLicenseState"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionLicenseState": {
      "oneOf": [
        {
          "const": "declared"
        },
        {
          "const": "missing"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionCodeRole": {
      "oneOf": [
        {
          "const": "inference"
        },
        {
          "const": "pretrain"
        },
        {
          "const": "both"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionCodeRoleEvidence": {
      "oneOf": [
        {
          "const": "repo_structure"
        },
        {
          "const": "training_entry"
        },
        {
          "const": "framework_marker"
        },
        {
          "const": "readme_training"
        },
        {
          "const": "weight_release"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionDownload": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFile"
          }
        },
        "oversized": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionFetchFailure"
          }
        },
        "resumed": {
          "type": "boolean"
        }
      },
      "required": [
        "files",
        "oversized",
        "failures",
        "resumed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionFileKind"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionFileKind": {
      "oneOf": [
        {
          "const": "config"
        },
        {
          "const": "configuration"
        },
        {
          "const": "modeling"
        },
        {
          "const": "referenced_module"
        },
        {
          "const": "tokenizer_config"
        },
        {
          "const": "generation_config"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionFetchFailure": {
      "oneOf": [
        {
          "const": "network"
        },
        {
          "const": "permission"
        },
        {
          "const": "not_found"
        },
        {
          "const": "license_not_accepted"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionFingerprint": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionConfigFingerprint"
        },
        "code": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFingerprint"
        }
      },
      "required": [
        "config",
        "code"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionConfigFingerprint": {
      "type": "object",
      "properties": {
        "architectures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "num_hidden_layers": {
          "type": "integer"
        },
        "hidden_size": {
          "type": "integer"
        },
        "num_attention_heads": {
          "type": "integer"
        },
        "num_key_value_heads": {
          "type": "integer"
        },
        "intermediate_size": {
          "type": "integer"
        },
        "vocab_size": {
          "type": "integer"
        },
        "max_position_embeddings": {
          "type": "integer"
        },
        "torch_dtype": {
          "type": "string"
        },
        "tie_word_embeddings": {
          "type": "boolean"
        },
        "moe": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionMoeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "positional_encoding": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionPositionalEncoding"
        },
        "attention": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionAttentionVariant"
        }
      },
      "required": [
        "architectures",
        "num_hidden_layers",
        "hidden_size",
        "num_attention_heads",
        "num_key_value_heads",
        "intermediate_size",
        "vocab_size",
        "max_position_embeddings",
        "torch_dtype",
        "tie_word_embeddings",
        "moe",
        "positional_encoding",
        "attention"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionMoeSpec": {
      "type": "object",
      "properties": {
        "num_experts": {
          "type": "integer"
        },
        "num_active_experts": {
          "type": "integer"
        },
        "num_shared_experts": {
          "type": "integer"
        }
      },
      "required": [
        "num_experts",
        "num_active_experts",
        "num_shared_experts"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionPositionalEncoding": {
      "oneOf": [
        {
          "const": "rope"
        },
        {
          "const": "alibi"
        },
        {
          "const": "absolute"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionAttentionVariant": {
      "oneOf": [
        {
          "const": "mha"
        },
        {
          "const": "gqa"
        },
        {
          "const": "mqa"
        },
        {
          "const": "mla"
        },
        {
          "const": "linear"
        },
        {
          "const": "sliding_window"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionCodeFingerprint": {
      "type": "object",
      "properties": {
        "module_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionKeyCall"
          }
        },
        "special": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionSpecialOp"
          }
        }
      },
      "required": [
        "module_classes",
        "calls",
        "special"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionKeyCall": {
      "oneOf": [
        {
          "const": "attention"
        },
        {
          "const": "norm"
        },
        {
          "const": "mlp"
        },
        {
          "const": "residual"
        },
        {
          "const": "routing"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionSpecialOp": {
      "oneOf": [
        {
          "const": "custom_kernel"
        },
        {
          "const": "fused_op"
        },
        {
          "const": "quantization_branch"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionWorkspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "framework_major": {
          "type": "string"
        },
        "disk_policy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "env",
        "framework_major",
        "disk_policy"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionDedupRecord": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionDedupDecision"
        },
        "dropped_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Model"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "group",
        "decision",
        "dropped_by"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionDedupDecision": {
      "oneOf": [
        {
          "const": "kept"
        },
        {
          "const": "dropped"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableRecord": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableState"
        },
        "workload": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionRankWorkload"
        },
        "ranks": {
          "type": "integer"
        },
        "backend": {
          "type": "string"
        },
        "concurrency": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableFailure"
          }
        }
      },
      "required": [
        "state",
        "workload",
        "ranks",
        "backend",
        "concurrency",
        "failures"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableState": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionRankWorkload": {
      "oneOf": [
        {
          "const": "forward"
        },
        {
          "const": "prefill"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableFailure": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableFailureKind"
        },
        "step": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step",
        "summary"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionRunnableFailureKind": {
      "oneOf": [
        {
          "const": "timeout"
        },
        {
          "const": "oom"
        },
        {
          "const": "assertion"
        },
        {
          "const": "missing_dependency"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionTrainingPairing": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionPairingKind"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.types.CollectionPairingTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionPairingKind": {
      "oneOf": [
        {
          "const": "same_org"
        },
        {
          "const": "same_architecture"
        },
        {
          "const": "external_link"
        },
        {
          "const": "unpaired"
        }
      ]
    },
    "aisp.bench.checkpoint.model_code_collection.types.CollectionPairingTarget": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repo",
        "commit"
      ],
      "additionalProperties": false
    }
  }
}
