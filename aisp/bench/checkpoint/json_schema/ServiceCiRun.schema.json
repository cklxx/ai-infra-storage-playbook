{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ServiceCiRun.schema.json",
  "title": "ServiceCiRun",
  "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.ServiceCiRun",
  "$defs": {
    "aisp.bench.checkpoint.evaluation_service.types.ServiceCiRun": {
      "type": "object",
      "properties": {
        "trigger": {
          "$ref": "#/$defs/aisp.bench.checkpoint.evaluation_service.types.ServiceCiTrigger"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.RunRecord"
          }
        },
        "small_scale_only": {
          "type": "boolean"
        },
        "backlink_required": {
          "type": "boolean"
        }
      },
      "required": [
        "trigger",
        "records",
        "small_scale_only",
        "backlink_required"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.evaluation_service.types.ServiceCiTrigger": {
      "oneOf": [
        {
          "const": "recipe_change"
        },
        {
          "const": "framework_upgrade"
        },
        {
          "const": "storage_change"
        },
        {
          "const": "regression"
        },
        {
          "const": "exploration"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample.types.RunRecord": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.State"
        },
        "progress": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.WorkProgress"
        },
        "artifacts": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Artifacts"
        }
      },
      "required": [
        "run_id",
        "state",
        "progress",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.State": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "queued": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.QueueProgress"
            }
          },
          "required": [
            "queued"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "running": {
              "type": "null"
            }
          },
          "required": [
            "running"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "null"
            }
          },
          "required": [
            "completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failed": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Failure"
            }
          },
          "required": [
            "failed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rejected": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Failure"
            }
          },
          "required": [
            "rejected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cancelled": {
              "type": "null"
            }
          },
          "required": [
            "cancelled"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample.types.QueueProgress": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "integer"
        },
        "len": {
          "type": "integer"
        }
      },
      "required": [
        "pos",
        "len"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Failure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.WorkProgress": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Artifacts": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.CkptSli"
          }
        },
        "slo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.CkptSlo"
          }
        },
        "report": {
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "metrics",
        "slo",
        "report"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.performance.types.CkptSli": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "check_point_duration_sli": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.CheckPointDurationMetric"
            }
          },
          "required": [
            "check_point_duration_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "training_stall_sli": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.TrainingStallMetric"
            }
          },
          "required": [
            "training_stall_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "restore_duration_sli": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.RestoreDurationMetric"
            }
          },
          "required": [
            "restore_duration_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_throughput_sli": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.WriteThroughputMetric"
            }
          },
          "required": [
            "write_throughput_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metadata_commit_sli": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.MetadataCommitMetric"
            }
          },
          "required": [
            "metadata_commit_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_latency_p99_sli": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.WriteLatencyP99Metric"
            }
          },
          "required": [
            "write_latency_p99_sli"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.performance.types.CheckPointDurationMetric": {
      "type": "number"
    },
    "aisp.bench.checkpoint.performance.types.TrainingStallMetric": {
      "type": "number"
    },
    "aisp.bench.checkpoint.performance.types.RestoreDurationMetric": {
      "type": "number"
    },
    "aisp.bench.checkpoint.performance.types.WriteThroughputMetric": {
      "type": "number"
    },
    "aisp.bench.checkpoint.performance.types.MetadataCommitMetric": {
      "type": "number"
    },
    "aisp.bench.checkpoint.performance.types.WriteLatencyP99Metric": {
      "type": "number"
    },
    "aisp.bench.checkpoint.performance.slo.CkptSlo": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "check_point_duration_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@90398eea"
            }
          },
          "required": [
            "check_point_duration_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "training_stall_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@c27f7a91"
            }
          },
          "required": [
            "training_stall_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "restore_duration_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@4e8638b8"
            }
          },
          "required": [
            "restore_duration_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_throughput_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricGE@57c89cb9"
            }
          },
          "required": [
            "write_throughput_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metadata_commit_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@f1d06d27"
            }
          },
          "required": [
            "metadata_commit_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_latency_p99_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@fdcaa9d0"
            }
          },
          "required": [
            "write_latency_p99_slo"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.performance.slo.MetricLE@90398eea": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.CheckPointDurationMetric"
        },
        "threshold": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.CheckPointDurationMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.performance.slo.MetricLE@c27f7a91": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.TrainingStallMetric"
        },
        "threshold": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.TrainingStallMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.performance.slo.MetricLE@4e8638b8": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.RestoreDurationMetric"
        },
        "threshold": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.RestoreDurationMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.performance.slo.MetricGE@57c89cb9": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.WriteThroughputMetric"
        },
        "threshold": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.WriteThroughputMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.performance.slo.MetricLE@f1d06d27": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.MetadataCommitMetric"
        },
        "threshold": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.MetadataCommitMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.performance.slo.MetricLE@fdcaa9d0": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.WriteLatencyP99Metric"
        },
        "threshold": {
          "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.WriteLatencyP99Metric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    }
  }
}
