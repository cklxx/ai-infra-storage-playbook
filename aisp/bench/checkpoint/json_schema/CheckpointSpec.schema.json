{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CheckpointSpec.schema.json",
  "title": "CheckpointSpec",
  "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointSpec",
  "$defs": {
    "aisp.bench.checkpoint.checkpoint.types.CheckpointSpec": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointSubject"
        },
        "bypass": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointBypassPlan"
        },
        "fidelity": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointFidelity"
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointGate"
          }
        },
        "alignment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointAlignmentStep"
          }
        },
        "scaling": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointScalingDimension"
          }
        },
        "extrapolation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointExtrapolationRule"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointAcceptanceItem"
          }
        }
      },
      "required": [
        "subject",
        "bypass",
        "fidelity",
        "gates",
        "alignment",
        "scaling",
        "extrapolation",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointSubject": {
      "type": "object",
      "properties": {
        "implementation": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Component"
        },
        "sharding": {
          "type": "string"
        },
        "write_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointWriteFeature"
          }
        },
        "read_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointReadFeature"
          }
        }
      },
      "required": [
        "implementation",
        "sharding",
        "write_features",
        "read_features"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointWriteFeature": {
      "oneOf": [
        {
          "const": "total_bytes"
        },
        {
          "const": "shard_count_and_size"
        },
        {
          "const": "write_concurrency"
        },
        {
          "const": "sync_or_async"
        },
        {
          "const": "compression"
        },
        {
          "const": "metadata_commit"
        },
        {
          "const": "write_period"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointReadFeature": {
      "oneOf": [
        {
          "const": "overlap_with_training_start"
        },
        {
          "const": "per_rank_parallel_read"
        },
        {
          "const": "hash_verification"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointBypassPlan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointBypassStep"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointBypassConstraint"
          }
        }
      },
      "required": [
        "steps",
        "constraints"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointBypassStep": {
      "oneOf": [
        {
          "const": "meta_model"
        },
        {
          "const": "meta_forward"
        },
        {
          "const": "placeholder_backward"
        },
        {
          "const": "mock_optimizer"
        },
        {
          "const": "unchanged_checkpoint_write"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointBypassConstraint": {
      "oneOf": [
        {
          "const": "model_code_source"
        },
        {
          "const": "parallel_strategy"
        },
        {
          "const": "parameter_init"
        },
        {
          "const": "mixed_precision"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointFidelity": {
      "type": "object",
      "properties": {
        "forward_backward": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "optimizer_step": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "parallel_split": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "checkpoint_write": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "checkpoint_read": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        }
      },
      "required": [
        "forward_backward",
        "optimizer_step",
        "parallel_split",
        "checkpoint_write",
        "checkpoint_read"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.fidelity.types.FidelityBoundary": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "bypassed": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.Bypassed"
        },
        "method": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.bypass.types.BypassMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "fidelity": {
          "$ref": "#/$defs/aisp.bench.checkpoint.bypass.types.FidelityLevel"
        },
        "kept": {
          "type": "string"
        },
        "known_bias": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bypassed",
        "method",
        "fidelity",
        "kept",
        "known_bias"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.fidelity.types.Bypassed": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "aisp.bench.checkpoint.bypass.types.BypassMethod": {
      "oneOf": [
        {
          "const": "meta_device"
        },
        {
          "const": "module_mock"
        },
        {
          "const": "cpu_offload"
        },
        {
          "const": "real_small_scale"
        }
      ]
    },
    "aisp.bench.checkpoint.bypass.types.FidelityLevel": {
      "oneOf": [
        {
          "const": "L0"
        },
        {
          "const": "L1"
        },
        {
          "const": "L2"
        },
        {
          "const": "L3"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointGate": {
      "oneOf": [
        {
          "const": "G0"
        },
        {
          "const": "G1"
        },
        {
          "const": "G2"
        },
        {
          "const": "G3-a"
        },
        {
          "const": "G3-b"
        },
        {
          "const": "G4"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointAlignmentStep": {
      "oneOf": [
        {
          "const": "minimal_config"
        },
        {
          "const": "real_and_bypass_runs"
        },
        {
          "const": "compare_metrics"
        },
        {
          "const": "attribute_deviations"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointScalingDimension": {
      "oneOf": [
        {
          "const": "parameter_count"
        },
        {
          "const": "cluster_size"
        },
        {
          "const": "data_parallel"
        },
        {
          "const": "tensor_pipeline_parallel"
        },
        {
          "const": "expert_parallel"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointExtrapolationRule": {
      "oneOf": [
        {
          "const": "aggregate_bandwidth"
        },
        {
          "const": "metadata_operations"
        },
        {
          "const": "parameter_bytes"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.types.CheckpointAcceptanceItem": {
      "oneOf": [
        {
          "const": "io_pattern_alignment"
        },
        {
          "const": "scaling_consistency"
        },
        {
          "const": "fidelity"
        },
        {
          "const": "reproducibility"
        },
        {
          "const": "coverage"
        }
      ]
    }
  }
}
