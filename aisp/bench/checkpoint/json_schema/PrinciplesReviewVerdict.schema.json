{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesReviewVerdict.schema.json",
  "title": "PrinciplesReviewVerdict",
  "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesReviewVerdict",
  "$defs": {
    "aisp.bench.checkpoint.principles.principles.PrinciplesReviewVerdict": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesReviewSubject"
        },
        "role": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesRole"
        },
        "decision": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesReviewDecision"
        }
      },
      "required": [
        "subject",
        "role",
        "decision"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesReviewSubject": {
      "oneOf": [
        {
          "const": "metric_change"
        },
        {
          "const": "threshold_change"
        },
        {
          "const": "incomparable_change"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesRole": {
      "oneOf": [
        {
          "const": "recipe_maintainer"
        },
        {
          "const": "metric_maintainer"
        },
        {
          "const": "service_maintainer"
        },
        {
          "const": "reviewer"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesReviewDecision": {
      "oneOf": [
        {
          "const": "allowed"
        },
        {
          "const": "self_review_forbidden"
        }
      ]
    }
  }
}
