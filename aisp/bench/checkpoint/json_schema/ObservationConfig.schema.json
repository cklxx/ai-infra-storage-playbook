{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ObservationConfig.schema.json",
  "title": "ObservationConfig",
  "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.ObservationConfig",
  "$defs": {
    "aisp.bench.checkpoint.ckpt_sample_interface.types.ObservationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "number"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.observation.types.ObservationLayer"
          }
        }
      },
      "required": [
        "enabled",
        "sample_rate",
        "layers"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.observation.types.ObservationLayer": {
      "oneOf": [
        {
          "const": "app"
        },
        {
          "const": "sys"
        },
        {
          "const": "storage"
        }
      ]
    }
  }
}
