{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CheckpointBypassPlan.schema.json",
  "title": "CheckpointBypassPlan",
  "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointBypassPlan",
  "$defs": {
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointBypassPlan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointBypassStep"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointBypassConstraint"
          }
        }
      },
      "required": [
        "steps",
        "constraints"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointBypassStep": {
      "oneOf": [
        {
          "const": "meta_model"
        },
        {
          "const": "meta_forward"
        },
        {
          "const": "placeholder_backward"
        },
        {
          "const": "mock_optimizer"
        },
        {
          "const": "unchanged_checkpoint_write"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointBypassConstraint": {
      "oneOf": [
        {
          "const": "model_code_source"
        },
        {
          "const": "parallel_strategy"
        },
        {
          "const": "parameter_init"
        },
        {
          "const": "mixed_precision"
        }
      ]
    }
  }
}
