{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/Component.schema.json",
  "title": "Component",
  "$ref": "#/$defs/ckpt_sample.Component",
  "$defs": {
    "ckpt_sample.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
