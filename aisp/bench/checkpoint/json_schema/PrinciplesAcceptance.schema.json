{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesAcceptance.schema.json",
  "title": "PrinciplesAcceptance",
  "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesAcceptance",
  "$defs": {
    "aisp.bench.checkpoint.principles.principles.PrinciplesAcceptance": {
      "type": "object",
      "properties": {
        "eval_set": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet"
        },
        "verdict": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesAcceptVerdict"
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.principles.PrinciplesSuccessCriterion"
          }
        }
      },
      "required": [
        "eval_set",
        "verdict",
        "missing"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesEvalSet": {
      "oneOf": [
        {
          "const": "checkpoint"
        },
        {
          "const": "dataset"
        },
        {
          "const": "kvcache"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesAcceptVerdict": {
      "oneOf": [
        {
          "const": "built"
        },
        {
          "const": "not_built"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.principles.PrinciplesSuccessCriterion": {
      "oneOf": [
        {
          "const": "reproducible"
        },
        {
          "const": "aligned"
        },
        {
          "const": "scaling_validated"
        },
        {
          "const": "gaps_registered"
        },
        {
          "const": "loop_proven"
        }
      ]
    }
  }
}
