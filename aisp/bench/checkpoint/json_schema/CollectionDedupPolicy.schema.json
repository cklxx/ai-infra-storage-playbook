{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionDedupPolicy.schema.json",
  "title": "CollectionDedupPolicy",
  "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.collection.CollectionDedupPolicy",
  "$defs": {
    "aisp.bench.checkpoint.model_code_collection.collection.CollectionDedupPolicy": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "variety": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.model_code_collection.collection.CollectionVarietyAxis"
          }
        }
      },
      "required": [
        "threshold",
        "weights",
        "variety"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.model_code_collection.collection.CollectionVarietyAxis": {
      "oneOf": [
        {
          "const": "scale"
        },
        {
          "const": "positional_encoding"
        },
        {
          "const": "attention_variant"
        },
        {
          "const": "moe"
        }
      ]
    }
  }
}
