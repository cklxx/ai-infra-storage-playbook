          "required": [
            "write_throughput_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metadata_commit_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@f1d06d27"
            }
          },
          "required": [
            "metadata_commit_slo"
          ],
          "additionalProperties": false
