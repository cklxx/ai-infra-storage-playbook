{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/Bench.schema.json",
  "title": "Bench",
  "$ref": "#/$defs/aisp.bench.checkpoint.readme.types.Bench",
  "$defs": {
    "aisp.bench.checkpoint.readme.types.Bench": {
      "type": "object",
      "properties": {
        "corpus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Model"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.RunSpec"
          }
        },
        "storages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.StorageLayer"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.RunRecord"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.readme.types.Gap"
          }
        }
      },
      "required": [
        "corpus",
        "samples",
        "storages",
        "runs",
        "gaps"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.RunSpec": {
      "type": "object",
      "properties": {
        "sample": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "storage": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.StorageLayer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "sample",
        "config",
        "storage",
        "seed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.StorageLayer": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Component"
        },
        "adapter": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Component"
        }
      },
      "required": [
        "backend",
        "adapter"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.RunRecord": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.State"
        },
        "progress": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.WorkProgress"
        },
        "artifacts": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Artifacts"
        }
      },
      "required": [
        "run_id",
        "state",
        "progress",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.State": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "queued": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.QueueProgress"
            }
          },
          "required": [
            "queued"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "running": {
              "type": "null"
            }
          },
          "required": [
            "running"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "null"
            }
          },
          "required": [
            "completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failed": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Failure"
            }
          },
          "required": [
            "failed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rejected": {
              "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Failure"
            }
          },
          "required": [
            "rejected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cancelled": {
              "type": "null"
            }
          },
          "required": [
            "cancelled"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.QueueProgress": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "integer"
        },
        "len": {
          "type": "integer"
        }
      },
      "required": [
        "pos",
        "len"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Failure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.WorkProgress": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Artifacts": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.performance.types.CkptSli"
          }
        },
        "slo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.CkptSlo"
          }
        },
        "report": {
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "metrics",
        "slo",
        "report"
      ],
      "additionalProperties": false
