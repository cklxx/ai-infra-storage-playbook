          "required": [
            "training_stall_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "restore_duration_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@4e8638b8"
