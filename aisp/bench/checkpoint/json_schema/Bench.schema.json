      "oneOf": [
        {
          "type": "object",
          "properties": {
            "check_point_duration_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@90398eea"
            }
          },
          "required": [
            "check_point_duration_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "training_stall_slo": {
              "$ref": "#/$defs/aisp.bench.checkpoint.performance.slo.MetricLE@c27f7a91"
            }
