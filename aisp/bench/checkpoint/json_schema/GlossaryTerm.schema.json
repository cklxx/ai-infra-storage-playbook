{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/GlossaryTerm.schema.json",
  "title": "GlossaryTerm",
  "$ref": "#/$defs/aisp.bench.checkpoint.appendix_glossary.types.GlossaryTerm",
  "$defs": {
    "aisp.bench.checkpoint.appendix_glossary.types.GlossaryTerm": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "parallel_strategy": {
              "$ref": "#/$defs/aisp.bench.checkpoint.appendix_glossary.types.ParallelStrategyTerm"
            }
          },
          "required": [
            "parallel_strategy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "model_structure": {
              "$ref": "#/$defs/aisp.bench.checkpoint.appendix_glossary.types.ModelStructureTerm"
            }
          },
          "required": [
            "model_structure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "storage_io": {
              "$ref": "#/$defs/aisp.bench.checkpoint.appendix_glossary.types.StorageIoTerm"
            }
          },
          "required": [
            "storage_io"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bypass": {
              "$ref": "#/$defs/aisp.bench.checkpoint.appendix_glossary.types.BypassTerm"
            }
          },
          "required": [
            "bypass"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.checkpoint.appendix_glossary.types.ParallelStrategyTerm": {
      "oneOf": [
        {
          "const": "DP"
        },
        {
          "const": "TP"
        },
        {
          "const": "PP"
        },
        {
          "const": "EP"
        }
      ]
    },
    "aisp.bench.checkpoint.appendix_glossary.types.ModelStructureTerm": {
      "oneOf": [
        {
          "const": "MoE"
        },
        {
          "const": "GQA"
        },
        {
          "const": "MQA"
        },
        {
          "const": "MLA"
        },
        {
          "const": "prefill"
        },
        {
          "const": "decode"
        }
      ]
    },
    "aisp.bench.checkpoint.appendix_glossary.types.StorageIoTerm": {
      "oneOf": [
        {
          "const": "shard"
        },
        {
          "const": "aggregate_bandwidth"
        },
        {
          "const": "metadata_op"
        },
        {
          "const": "read_amplification"
        },
        {
          "const": "tail_latency"
        },
        {
          "const": "baseline"
        },
        {
          "const": "inconclusive"
        }
      ]
    },
    "aisp.bench.checkpoint.appendix_glossary.types.BypassTerm": {
      "oneOf": [
        {
          "const": "meta_device"
        },
        {
          "const": "module_mock"
        },
        {
          "const": "process_group"
        },
        {
          "const": "activation_checkpoint"
        }
      ]
    }
  }
}
