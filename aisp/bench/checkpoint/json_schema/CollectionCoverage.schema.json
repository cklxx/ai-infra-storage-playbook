{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CollectionCoverage.schema.json",
  "title": "CollectionCoverage",
  "$ref": "#/$defs/collection.CollectionCoverage",
  "$defs": {
    "collection.CollectionCoverage": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection.CollectionCoverageCell"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection.CollectionGap"
          }
        }
      },
      "required": [
        "cells",
        "gaps"
      ],
      "additionalProperties": false
    },
    "collection.CollectionCoverageCell": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/collection.CollectionCoverageDimension"
        },
        "bucket": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "bucket",
        "count"
      ],
      "additionalProperties": false
    },
    "collection.CollectionCoverageDimension": {
      "oneOf": [
        {
          "const": "architecture_family"
        },
        {
          "const": "scale"
        },
        {
          "const": "framework_version"
        }
      ]
    },
    "collection.CollectionGap": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/collection.CollectionGapKind"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false
    },
    "collection.CollectionGapKind": {
      "oneOf": [
        {
          "const": "unknown_code_role"
        },
        {
          "const": "unpaired_training"
        },
        {
          "const": "empty_cell"
        }
      ]
    }
  }
}
