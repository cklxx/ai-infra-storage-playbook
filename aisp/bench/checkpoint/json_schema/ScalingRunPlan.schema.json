{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/ScalingRunPlan.schema.json",
  "title": "ScalingRunPlan",
  "$ref": "#/$defs/aisp.bench.checkpoint.scaling.scale_types.ScalingRunPlan",
  "$defs": {
    "aisp.bench.checkpoint.scaling.scale_types.ScalingRunPlan": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.scale_types.ScalingDimension"
        },
        "fixed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.scaling.scale_types.ScalingFixedDimension"
          }
        }
      },
      "required": [
        "dimension",
        "fixed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.scaling.scale_types.ScalingDimension": {
      "oneOf": [
        {
          "const": "model_scale"
        },
        {
          "const": "cluster_size"
        },
        {
          "const": "parallel_strategy"
        },
        {
          "const": "load"
        },
        {
          "const": "storage_backend"
        }
      ]
    },
    "aisp.bench.checkpoint.scaling.scale_types.ScalingFixedDimension": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/aisp.bench.checkpoint.scaling.scale_types.ScalingDimension"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
