{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesContinuousBenchmark.schema.json",
  "title": "PrinciplesContinuousBenchmark",
  "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesContinuousBenchmark",
  "$defs": {
    "aisp.bench.checkpoint.principles.types.PrinciplesContinuousBenchmark": {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesBenchmarkReason"
          }
        },
        "loop": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesClosedLoop"
        }
      },
      "required": [
        "reasons",
        "loop"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesBenchmarkReason": {
      "oneOf": [
        {
          "const": "coverage"
        },
        {
          "const": "extrapolation"
        },
        {
          "const": "decay"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesClosedLoop": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesLoopPart"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesLoopStage"
          }
        },
        "human": {
          "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesHumanInLoop"
        }
      },
      "required": [
        "parts",
        "stages",
        "human"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesLoopPart": {
      "oneOf": [
        {
          "const": "eval_set"
        },
        {
          "const": "eval_service"
        },
        {
          "const": "extension"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesLoopStage": {
      "oneOf": [
        {
          "const": "current_set"
        },
        {
          "const": "service_run"
        },
        {
          "const": "gap_analysis"
        },
        {
          "const": "new_version"
        },
        {
          "const": "regression"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesHumanInLoop": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesAutomatedStep"
          }
        },
        "reviewed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.principles.types.PrinciplesReviewSubject"
          }
        }
      },
      "required": [
        "automatic",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesAutomatedStep": {
      "oneOf": [
        {
          "const": "find_gaps"
        },
        {
          "const": "generate_candidates"
        },
        {
          "const": "regress"
        }
      ]
    },
    "aisp.bench.checkpoint.principles.types.PrinciplesReviewSubject": {
      "oneOf": [
        {
          "const": "metric_change"
        },
        {
          "const": "threshold_change"
        },
        {
          "const": "incomparable_change"
        }
      ]
    }
  }
}
