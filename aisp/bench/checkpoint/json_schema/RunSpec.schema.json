{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/RunSpec.schema.json",
  "title": "RunSpec",
  "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.RunSpec",
  "$defs": {
    "aisp.bench.checkpoint.ckpt_sample_interface.types.RunSpec": {
      "type": "object",
      "properties": {
        "sample": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "storage": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.StorageLayer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "sample",
        "config",
        "storage",
        "seed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.StorageLayer": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Component"
        },
        "adapter": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample_interface.types.Component"
        }
      },
      "required": [
        "backend",
        "adapter"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample_interface.types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
