{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/RunSpec.schema.json",
  "title": "RunSpec",
  "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.RunSpec",
  "$defs": {
    "aisp.bench.checkpoint.ckpt_sample.types.RunSpec": {
      "type": "object",
      "properties": {
        "sample": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.SampleConfigBase"
        },
        "storage": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.StorageLayer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "sample",
        "config",
        "storage",
        "seed"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.SampleConfigBase": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Model"
        },
        "topology": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Topology"
        },
        "observe": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.ObservationConfig"
        }
      },
      "required": [
        "model",
        "topology",
        "observe"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Topology": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "gpus_per_node": {
          "type": "integer"
        },
        "network": {
          "type": "string"
        },
        "mount": {
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "gpus_per_node",
        "network",
        "mount"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.ObservationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "number"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.observation.types.ObservationLayer"
          }
        }
      },
      "required": [
        "enabled",
        "sample_rate",
        "layers"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.observation.types.ObservationLayer": {
      "oneOf": [
        {
          "const": "app"
        },
        {
          "const": "sys"
        },
        {
          "const": "storage"
        }
      ]
    },
    "aisp.bench.checkpoint.ckpt_sample.types.StorageLayer": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Component"
        },
        "adapter": {
          "$ref": "#/$defs/aisp.bench.checkpoint.ckpt_sample.types.Component"
        }
      },
      "required": [
        "backend",
        "adapter"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.ckpt_sample.types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
