{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CheckpointFidelity.schema.json",
  "title": "CheckpointFidelity",
  "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.types.CheckpointFidelity",
  "$defs": {
    "aisp.bench.checkpoint.checkpoint.types.CheckpointFidelity": {
      "type": "object",
      "properties": {
        "forward_backward": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "optimizer_step": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "parallel_split": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "checkpoint_write": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        },
        "checkpoint_read": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.FidelityBoundary"
        }
      },
      "required": [
        "forward_backward",
        "optimizer_step",
        "parallel_split",
        "checkpoint_write",
        "checkpoint_read"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.fidelity.types.FidelityBoundary": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "bypassed": {
          "$ref": "#/$defs/aisp.bench.checkpoint.fidelity.types.Bypassed"
        },
        "method": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.bypass.types.BypassMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "fidelity": {
          "$ref": "#/$defs/aisp.bench.checkpoint.bypass.types.FidelityLevel"
        },
        "kept": {
          "type": "string"
        },
        "known_bias": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bypassed",
        "method",
        "fidelity",
        "kept",
        "known_bias"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.fidelity.types.Bypassed": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "aisp.bench.checkpoint.bypass.types.BypassMethod": {
      "oneOf": [
        {
          "const": "meta_device"
        },
        {
          "const": "module_mock"
        },
        {
          "const": "cpu_offload"
        },
        {
          "const": "real_small_scale"
        }
      ]
    },
    "aisp.bench.checkpoint.bypass.types.FidelityLevel": {
      "oneOf": [
        {
          "const": "L0"
        },
        {
          "const": "L1"
        },
        {
          "const": "L2"
        },
        {
          "const": "L3"
        }
      ]
    }
  }
}
