{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/PrinciplesGap.schema.json",
  "title": "PrinciplesGap",
  "$ref": "#/$defs/principles.PrinciplesGap",
  "$defs": {
    "principles.PrinciplesGap": {
      "type": "object",
      "properties": {
        "cell": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/principles.PrinciplesGapKind"
        },
        "discovered_by_service": {
          "type": "boolean"
        }
      },
      "required": [
        "cell",
        "kind",
        "discovered_by_service"
      ],
      "additionalProperties": false
    },
    "principles.PrinciplesGapKind": {
      "oneOf": [
        {
          "const": "new_architecture"
        },
        {
          "const": "new_framework"
        },
        {
          "const": "new_parallel_strategy"
        },
        {
          "const": "uncovered_io_feature"
        }
      ]
    }
  }
}
