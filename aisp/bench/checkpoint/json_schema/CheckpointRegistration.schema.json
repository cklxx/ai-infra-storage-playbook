{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/checkpoint/json_schema/CheckpointRegistration.schema.json",
  "title": "CheckpointRegistration",
  "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointRegistration",
  "$defs": {
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointRegistration": {
      "type": "object",
      "properties": {
        "conclusion": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointConclusion"
        },
        "coverage_updated": {
          "type": "boolean"
        }
      },
      "required": [
        "conclusion",
        "coverage_updated"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointConclusion": {
      "type": "object",
      "properties": {
        "alignment": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointAlignment"
        },
        "scaling": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingRun"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointAcceptanceItem"
          }
        },
        "backlink": {
          "type": "string"
        }
      },
      "required": [
        "alignment",
        "scaling",
        "acceptance",
        "backlink"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointAlignment": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointAlignmentStep"
          }
        },
        "within_tolerance": {
          "type": "boolean"
        }
      },
      "required": [
        "steps",
        "within_tolerance"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointAlignmentStep": {
      "oneOf": [
        {
          "const": "minimal_config"
        },
        {
          "const": "real_and_bypass_runs"
        },
        {
          "const": "compare_metrics"
        },
        {
          "const": "attribute_deviations"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingRun": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingDimension"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/aisp.bench.checkpoint.scaling.levels.Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "invariants_kept": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "target",
        "invariants_kept",
        "attribution"
      ],
      "additionalProperties": false
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointScalingDimension": {
      "oneOf": [
        {
          "const": "parameter_count"
        },
        {
          "const": "cluster_size"
        },
        {
          "const": "data_parallel"
        },
        {
          "const": "tensor_pipeline_parallel"
        },
        {
          "const": "expert_parallel"
        }
      ]
    },
    "aisp.bench.checkpoint.scaling.levels.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    },
    "aisp.bench.checkpoint.checkpoint.checkpoint.CheckpointAcceptanceItem": {
      "oneOf": [
        {
          "const": "io_pattern_alignment"
        },
        {
          "const": "scaling_consistency"
        },
        {
          "const": "fidelity"
        },
        {
          "const": "reproducibility"
        },
        {
          "const": "coverage"
        }
      ]
    }
  }
}
