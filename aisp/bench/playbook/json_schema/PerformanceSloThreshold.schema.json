{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/PerformanceSloThreshold.schema.json",
  "title": "PerformanceSloThreshold",
  "$ref": "#/$defs/performance.PerformanceSloThreshold",
  "$defs": {
    "performance.PerformanceSloThreshold": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "comparator": {
          "$ref": "#/$defs/performance.PerformanceComparator"
        },
        "target": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/performance.PerformanceThresholdProvenance"
        },
        "valid_for": {
          "$ref": "#/$defs/performance.PerformanceThresholdScope"
        },
        "review_due": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "metric",
        "comparator",
        "target",
        "unit",
        "provenance",
        "valid_for",
        "review_due"
      ],
      "additionalProperties": false
    },
    "performance.PerformanceComparator": {
      "oneOf": [
        {
          "const": "<="
        },
        {
          "const": ">="
        }
      ]
    },
    "performance.PerformanceThresholdProvenance": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/performance.PerformanceThresholdProvenanceKind"
        },
        "ref": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "date"
      ],
      "additionalProperties": false
    },
    "performance.PerformanceThresholdProvenanceKind": {
      "oneOf": [
        {
          "const": "requirement"
        },
        {
          "const": "baseline"
        },
        {
          "const": "ceiling"
        }
      ]
    },
    "performance.PerformanceThresholdScope": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topology": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/levels.Level"
          }
        }
      },
      "required": [
        "backend",
        "adapter",
        "topology"
      ],
      "additionalProperties": false
    },
    "levels.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    }
  }
}
