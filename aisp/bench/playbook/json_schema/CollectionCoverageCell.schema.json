{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/CollectionCoverageCell.schema.json",
  "title": "CollectionCoverageCell",
  "$ref": "#/$defs/collection.CollectionCoverageCell",
  "$defs": {
    "collection.CollectionCoverageCell": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/collection.CollectionCoverageDimension"
        },
        "bucket": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "bucket",
        "count"
      ],
      "additionalProperties": false
    },
    "collection.CollectionCoverageDimension": {
      "oneOf": [
        {
          "const": "architecture_family"
        },
        {
          "const": "scale"
        },
        {
          "const": "framework_version"
        }
      ]
    }
  }
}
