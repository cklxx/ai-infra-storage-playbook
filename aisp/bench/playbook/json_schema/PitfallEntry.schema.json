{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/PitfallEntry.schema.json",
  "title": "PitfallEntry",
  "$ref": "#/$defs/pitfalls.PitfallEntry",
  "$defs": {
    "pitfalls.PitfallEntry": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/pitfalls.PitfallCategory"
        },
        "pitfall": {
          "$ref": "#/$defs/pitfalls.Pitfall"
        },
        "symptom": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "disposition": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/pitfalls.PitfallStatus"
        }
      },
      "required": [
        "category",
        "pitfall",
        "symptom",
        "cause",
        "disposition",
        "status"
      ],
      "additionalProperties": false
    },
    "pitfalls.PitfallCategory": {
      "oneOf": [
        {
          "const": "methodology"
        },
        {
          "const": "model_code"
        },
        {
          "const": "checkpoint"
        },
        {
          "const": "dataset_kvcache"
        },
        {
          "const": "evaluation_service"
        }
      ]
    },
    "pitfalls.Pitfall": {
      "oneOf": [
        {
          "const": "observation_overhead"
        },
        {
          "const": "layer_mismatch"
        },
        {
          "const": "timing_compressed"
        },
        {
          "const": "serial_ranks"
        },
        {
          "const": "cold_warm_cache"
        },
        {
          "const": "bypass_memory_leak"
        },
        {
          "const": "dependency_hell"
        },
        {
          "const": "runnability_as_performance"
        },
        {
          "const": "mock_comm_wrong_tensor"
        },
        {
          "const": "dedup_false_positive"
        },
        {
          "const": "fake_pairing"
        },
        {
          "const": "missing_license"
        },
        {
          "const": "meta_device_incompatible"
        },
        {
          "const": "async_checkpoint_timing"
        },
        {
          "const": "shard_metadata_cost"
        },
        {
          "const": "optimizer_state_dropped"
        },
        {
          "const": "parallel_run_interference"
        },
        {
          "const": "missing_backlink"
        },
        {
          "const": "invalid_run_counted"
        },
        {
          "const": "version_drift"
        }
      ]
    },
    "pitfalls.PitfallStatus": {
      "oneOf": [
        {
          "const": "resolved"
        },
        {
          "const": "partially_resolved"
        },
        {
          "const": "open"
        },
        {
          "const": "rule_fixed"
        },
        {
          "const": "rule_fixed_unquantified"
        }
      ]
    }
  }
}
