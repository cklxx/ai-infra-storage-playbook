{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/CollectionRunnableRecord.schema.json",
  "title": "CollectionRunnableRecord",
  "$ref": "#/$defs/collection.CollectionRunnableRecord",
  "$defs": {
    "collection.CollectionRunnableRecord": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/collection.CollectionRunnableState"
        },
        "workload": {
          "$ref": "#/$defs/collection.CollectionRankWorkload"
        },
        "ranks": {
          "type": "integer"
        },
        "backend": {
          "type": "string"
        },
        "concurrency": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection.CollectionRunnableFailure"
          }
        }
      },
      "required": [
        "state",
        "workload",
        "ranks",
        "backend",
        "concurrency",
        "failures"
      ],
      "additionalProperties": false
    },
    "collection.CollectionRunnableState": {
      "oneOf": [
        {
          "const": "yes"
        },
        {
          "const": "no"
        },
        {
          "const": "partial"
        }
      ]
    },
    "collection.CollectionRankWorkload": {
      "oneOf": [
        {
          "const": "forward"
        },
        {
          "const": "prefill"
        }
      ]
    },
    "collection.CollectionRunnableFailure": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/collection.CollectionRunnableFailureKind"
        },
        "step": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step",
        "summary"
      ],
      "additionalProperties": false
    },
    "collection.CollectionRunnableFailureKind": {
      "oneOf": [
        {
          "const": "timeout"
        },
        {
          "const": "oom"
        },
        {
          "const": "assertion"
        },
        {
          "const": "missing_dependency"
        }
      ]
    }
  }
}
