{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/Artifacts.schema.json",
  "title": "Artifacts",
  "$ref": "#/$defs/types.Artifacts",
  "$defs": {
    "types.Artifacts": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/types.CkptSli"
          }
        },
        "slo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/types.CkptSlo"
          }
        },
        "report": {
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "metrics",
        "slo",
        "report"
      ],
      "additionalProperties": false
    },
    "types.CkptSli": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "check_point_duration_sli": {
              "$ref": "#/$defs/types.CheckPointDurationMetric"
            }
          },
          "required": [
            "check_point_duration_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "training_stall_sli": {
              "$ref": "#/$defs/types.TrainingStallMetric"
            }
          },
          "required": [
            "training_stall_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "restore_duration_sli": {
              "$ref": "#/$defs/types.RestoreDurationMetric"
            }
          },
          "required": [
            "restore_duration_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_throughput_sli": {
              "$ref": "#/$defs/types.WriteThroughputMetric"
            }
          },
          "required": [
            "write_throughput_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metadata_commit_sli": {
              "$ref": "#/$defs/types.MetadataCommitMetric"
            }
          },
          "required": [
            "metadata_commit_sli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_latency_p99_sli": {
              "$ref": "#/$defs/types.WriteLatencyP99Metric"
            }
          },
          "required": [
            "write_latency_p99_sli"
          ],
          "additionalProperties": false
        }
      ]
    },
    "types.CheckPointDurationMetric": {
      "type": "number"
    },
    "types.TrainingStallMetric": {
      "type": "number"
    },
    "types.RestoreDurationMetric": {
      "type": "number"
    },
    "types.WriteThroughputMetric": {
      "type": "number"
    },
    "types.MetadataCommitMetric": {
      "type": "number"
    },
    "types.WriteLatencyP99Metric": {
      "type": "number"
    },
    "types.CkptSlo": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "check_point_duration_slo": {
              "$ref": "#/$defs/types.MetricLE@1910e53e"
            }
          },
          "required": [
            "check_point_duration_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "training_stall_slo": {
              "$ref": "#/$defs/types.MetricLE@f4dd4d27"
            }
          },
          "required": [
            "training_stall_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "restore_duration_slo": {
              "$ref": "#/$defs/types.MetricLE@f421fc96"
            }
          },
          "required": [
            "restore_duration_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_throughput_slo": {
              "$ref": "#/$defs/types.MetricGE@c5b2fe43"
            }
          },
          "required": [
            "write_throughput_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metadata_commit_slo": {
              "$ref": "#/$defs/types.MetricLE@292a31ac"
            }
          },
          "required": [
            "metadata_commit_slo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write_latency_p99_slo": {
              "$ref": "#/$defs/types.MetricLE@9a4b591e"
            }
          },
          "required": [
            "write_latency_p99_slo"
          ],
          "additionalProperties": false
        }
      ]
    },
    "types.MetricLE@1910e53e": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/types.CheckPointDurationMetric"
        },
        "threshold": {
          "$ref": "#/$defs/types.CheckPointDurationMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "types.MetricLE@f4dd4d27": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/types.TrainingStallMetric"
        },
        "threshold": {
          "$ref": "#/$defs/types.TrainingStallMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "types.MetricLE@f421fc96": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/types.RestoreDurationMetric"
        },
        "threshold": {
          "$ref": "#/$defs/types.RestoreDurationMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "types.MetricGE@c5b2fe43": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/types.WriteThroughputMetric"
        },
        "threshold": {
          "$ref": "#/$defs/types.WriteThroughputMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "types.MetricLE@292a31ac": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/types.MetadataCommitMetric"
        },
        "threshold": {
          "$ref": "#/$defs/types.MetadataCommitMetric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    },
    "types.MetricLE@9a4b591e": {
      "type": "object",
      "properties": {
        "actual": {
          "$ref": "#/$defs/types.WriteLatencyP99Metric"
        },
        "threshold": {
          "$ref": "#/$defs/types.WriteLatencyP99Metric"
        }
      },
      "required": [
        "actual",
        "threshold"
      ],
      "additionalProperties": false
    }
  }
}
