{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/PerformanceThresholdProvenance.schema.json",
  "title": "PerformanceThresholdProvenance",
  "$ref": "#/$defs/performance.PerformanceThresholdProvenance",
  "$defs": {
    "performance.PerformanceThresholdProvenance": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/performance.PerformanceThresholdProvenanceKind"
        },
        "ref": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "date"
      ],
      "additionalProperties": false
    },
    "performance.PerformanceThresholdProvenanceKind": {
      "oneOf": [
        {
          "const": "requirement"
        },
        {
          "const": "baseline"
        },
        {
          "const": "ceiling"
        }
      ]
    }
  }
}
