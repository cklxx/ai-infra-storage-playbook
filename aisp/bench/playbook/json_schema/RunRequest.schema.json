{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/RunRequest.schema.json",
  "title": "RunRequest",
  "$ref": "#/$defs/service.RunRequest",
  "$defs": {
    "service.RunRequest": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string"
        },
        "recipe_version": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/configs.Model"
        },
        "framework": {
          "oneOf": [
            {
              "$ref": "#/$defs/service.Framework"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "$ref": "#/$defs/levels.Level"
        },
        "topology": {
          "$ref": "#/$defs/configs.Topology"
        },
        "storage": {
          "$ref": "#/$defs/types.StorageLayer"
        },
        "load": {
          "$ref": "#/$defs/service.Load"
        },
        "observe": {
          "$ref": "#/$defs/configs.ObservationConfig"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "recipe",
        "recipe_version",
        "model",
        "framework",
        "level",
        "topology",
        "storage",
        "load",
        "observe",
        "seed"
      ],
      "additionalProperties": false
    },
    "configs.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "service.Framework": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "levels.Level": {
      "oneOf": [
        {
          "const": "S0"
        },
        {
          "const": "S1"
        },
        {
          "const": "S2"
        },
        {
          "const": "S3"
        },
        {
          "const": "S4"
        },
        {
          "const": "S5"
        }
      ]
    },
    "configs.Topology": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "gpus_per_node": {
          "type": "integer"
        },
        "network": {
          "type": "string"
        },
        "mount": {
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "gpus_per_node",
        "network",
        "mount"
      ],
      "additionalProperties": false
    },
    "types.StorageLayer": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/types.Component"
        },
        "adapter": {
          "$ref": "#/$defs/types.Component"
        }
      },
      "required": [
        "backend",
        "adapter"
      ],
      "additionalProperties": false
    },
    "types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "service.Load": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "duration_s": {
          "type": "integer"
        },
        "input_len": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_len": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrival_interval_ms": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_size": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concurrency",
        "duration_s",
        "input_len",
        "output_len",
        "arrival_interval_ms",
        "batch_size"
      ],
      "additionalProperties": false
    },
    "configs.ObservationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "number"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation.ObservationLayer"
          }
        }
      },
      "required": [
        "enabled",
        "sample_rate",
        "layers"
      ],
      "additionalProperties": false
    },
    "observation.ObservationLayer": {
      "oneOf": [
        {
          "const": "app"
        },
        {
          "const": "sys"
        },
        {
          "const": "storage"
        }
      ]
    }
  }
}
