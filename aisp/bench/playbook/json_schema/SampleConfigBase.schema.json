{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/SampleConfigBase.schema.json",
  "title": "SampleConfigBase",
  "$ref": "#/$defs/configs.SampleConfigBase",
  "$defs": {
    "configs.SampleConfigBase": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "#/$defs/configs.Model"
        },
        "topology": {
          "$ref": "#/$defs/configs.Topology"
        },
        "observe": {
          "$ref": "#/$defs/configs.ObservationConfig"
        }
      },
      "required": [
        "model",
        "topology",
        "observe"
      ],
      "additionalProperties": false
    },
    "configs.Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "git_commit_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "configs.Topology": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "gpus_per_node": {
          "type": "integer"
        },
        "network": {
          "type": "string"
        },
        "mount": {
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "gpus_per_node",
        "network",
        "mount"
      ],
      "additionalProperties": false
    },
    "configs.ObservationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "number"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "sample_rate",
        "layers"
      ],
      "additionalProperties": false
    }
  }
}
