{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/PerformanceStorageLayer.schema.json",
  "title": "PerformanceStorageLayer",
  "$ref": "#/$defs/performance.PerformanceStorageLayer",
  "$defs": {
    "performance.PerformanceStorageLayer": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "#/$defs/types.Component"
        },
        "config_ref": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "config_ref"
      ],
      "additionalProperties": false
    },
    "types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    }
  }
}
