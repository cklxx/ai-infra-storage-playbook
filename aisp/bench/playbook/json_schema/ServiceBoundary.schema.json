{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/ServiceBoundary.schema.json",
  "title": "ServiceBoundary",
  "$ref": "#/$defs/service.ServiceBoundary",
  "$defs": {
    "service.ServiceBoundary": {
      "type": "object",
      "properties": {
        "does": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service.ServiceResponsibility"
          }
        },
        "does_not": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service.ServiceOutOfScope"
          }
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "does",
        "does_not",
        "rule"
      ],
      "additionalProperties": false
    },
    "service.ServiceResponsibility": {
      "oneOf": [
        {
          "const": "accept_and_validate"
        },
        {
          "const": "prepare_and_execute"
        },
        {
          "const": "collect_and_aggregate"
        },
        {
          "const": "write_artifacts_and_manifest"
        },
        {
          "const": "write_back_latest_run"
        }
      ]
    },
    "service.ServiceOutOfScope": {
      "oneOf": [
        {
          "const": "decide_coverage"
        },
        {
          "const": "change_recipe_semantics"
        },
        {
          "const": "explain_business_result"
        },
        {
          "const": "retain_raw_trace"
        },
        {
          "const": "merge_metric_change"
        }
      ]
    }
  }
}
