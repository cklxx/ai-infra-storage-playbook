{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/Load.schema.json",
  "title": "Load",
  "$ref": "#/$defs/service.Load",
  "$defs": {
    "service.Load": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "duration_s": {
          "type": "integer"
        },
        "input_len": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_len": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrival_interval_ms": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_size": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concurrency",
        "duration_s",
        "input_len",
        "output_len",
        "arrival_interval_ms",
        "batch_size"
      ],
      "additionalProperties": false
    }
  }
}
