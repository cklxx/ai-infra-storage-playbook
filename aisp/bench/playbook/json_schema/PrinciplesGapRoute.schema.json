{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/PrinciplesGapRoute.schema.json",
  "title": "PrinciplesGapRoute",
  "$ref": "#/$defs/principles.PrinciplesGapRoute",
  "$defs": {
    "principles.PrinciplesGapRoute": {
      "type": "object",
      "properties": {
        "gap": {
          "$ref": "#/$defs/principles.PrinciplesGap"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/principles.PrinciplesLoopStage"
          }
        }
      },
      "required": [
        "gap",
        "stages"
      ],
      "additionalProperties": false
    },
    "principles.PrinciplesGap": {
      "type": "object",
      "properties": {
        "cell": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/principles.PrinciplesGapKind"
        },
        "discovered_by_service": {
          "type": "boolean"
        }
      },
      "required": [
        "cell",
        "kind",
        "discovered_by_service"
      ],
      "additionalProperties": false
    },
    "principles.PrinciplesGapKind": {
      "oneOf": [
        {
          "const": "new_architecture"
        },
        {
          "const": "new_framework"
        },
        {
          "const": "new_parallel_strategy"
        },
        {
          "const": "uncovered_io_feature"
        }
      ]
    },
    "principles.PrinciplesLoopStage": {
      "oneOf": [
        {
          "const": "current_set"
        },
        {
          "const": "service_run"
        },
        {
          "const": "gap_analysis"
        },
        {
          "const": "new_version"
        },
        {
          "const": "regression"
        }
      ]
    }
  }
}
