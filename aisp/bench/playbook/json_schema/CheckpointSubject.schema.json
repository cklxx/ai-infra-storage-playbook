{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/playbook/json_schema/CheckpointSubject.schema.json",
  "title": "CheckpointSubject",
  "$ref": "#/$defs/checkpoint.CheckpointSubject",
  "$defs": {
    "checkpoint.CheckpointSubject": {
      "type": "object",
      "properties": {
        "implementation": {
          "$ref": "#/$defs/types.Component"
        },
        "sharding": {
          "type": "string"
        },
        "write_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkpoint.CheckpointWriteFeature"
          }
        },
        "read_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkpoint.CheckpointReadFeature"
          }
        }
      },
      "required": [
        "implementation",
        "sharding",
        "write_features",
        "read_features"
      ],
      "additionalProperties": false
    },
    "types.Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_commit_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "git_commit_id"
      ],
      "additionalProperties": false
    },
    "checkpoint.CheckpointWriteFeature": {
      "oneOf": [
        {
          "const": "total_bytes"
        },
        {
          "const": "shard_count_and_size"
        },
        {
          "const": "write_concurrency"
        },
        {
          "const": "sync_or_async"
        },
        {
          "const": "compression"
        },
        {
          "const": "metadata_commit"
        },
        {
          "const": "write_period"
        }
      ]
    },
    "checkpoint.CheckpointReadFeature": {
      "oneOf": [
        {
          "const": "overlap_with_training_start"
        },
        {
          "const": "per_rank_parallel_read"
        },
        {
          "const": "hash_verification"
        }
      ]
    }
  }
}
