{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/examples/json_schema/ExampleRunReport.schema.json",
  "title": "ExampleRunReport",
  "$ref": "#/$defs/aisp.bench.examples.readme.types.ExampleRunReport",
  "$defs": {
    "aisp.bench.examples.readme.types.ExampleRunReport": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aisp.bench.examples.readme.types.ExampleRunResult"
          }
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "results",
        "mismatches"
      ],
      "additionalProperties": false
    },
    "aisp.bench.examples.readme.types.ExampleRunResult": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "$ref": "#/$defs/aisp.bench.examples.readme.types.ExamplePolarity"
        },
        "outcome": {
          "$ref": "#/$defs/aisp.bench.examples.readme.types.ExampleOutcome"
        }
      },
      "required": [
        "samples",
        "expected",
        "outcome"
      ],
      "additionalProperties": false
    },
    "aisp.bench.examples.readme.types.ExamplePolarity": {
      "oneOf": [
        {
          "const": "positive"
        },
        {
          "const": "negative"
        }
      ]
    },
    "aisp.bench.examples.readme.types.ExampleOutcome": {
      "oneOf": [
        {
          "const": "accepted"
        },
        {
          "const": "rejected"
        }
      ]
    }
  }
}
