{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-playbook/aisp/bench/examples/json_schema/ExampleRunPlan.schema.json",
  "title": "ExampleRunPlan",
  "$ref": "#/$defs/aisp.bench.examples.readme.examples.ExampleRunPlan",
  "$defs": {
    "aisp.bench.examples.readme.examples.ExampleRunPlan": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "$ref": "#/$defs/aisp.bench.examples.readme.examples.ExampleAllRun"
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "single": {
              "$ref": "#/$defs/aisp.bench.examples.readme.examples.ExampleSingleRun"
            }
          },
          "required": [
            "single"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aisp.bench.examples.readme.examples.ExampleAllRun": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "aisp.bench.examples.readme.examples.ExampleSingleRun": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "real": {
          "type": "string"
        },
        "bypassed": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "real",
        "bypassed",
        "metrics"
      ],
      "additionalProperties": false
    }
  }
}
